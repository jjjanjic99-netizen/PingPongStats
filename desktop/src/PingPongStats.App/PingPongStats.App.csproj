<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PingPongStats.App</RootNamespace>
    <AssemblyName>PingPongStats</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Defaults for `dotnet publish` without extra flags; see desktop/README.md
         for the full recommended publish command. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PingPongStats.Core\PingPongStats.Core.csproj" />
  </ItemGroup>

</Project>
