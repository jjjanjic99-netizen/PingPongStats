<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PingPongStats.App</RootNamespace>
    <AssemblyName>PingPongStats</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Defaults for `dotnet publish` without extra flags; see desktop/README.md
         for the full recommended publish command. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PingPongStats.Core\PingPongStats.Core.csproj" />
  </ItemGroup>

  <!-- Phase 14 sound effects: WAV files live in the repo under desktop/assets/sounds/
       (see that folder's README for the exact expected file names) and are copied
       next to the built EXE at sounds\*.wav, resolved at runtime via
       AppContext.BaseDirectory. Placeholder files ship in the repo - missing/invalid
       files are handled gracefully by WpfSoundService (no sound, no crash). -->
  <ItemGroup>
    <Content Include="..\..\assets\sounds\*.wav">
      <Link>sounds\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
