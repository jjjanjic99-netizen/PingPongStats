<Window x:Class="PingPongStats.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PingPongStats.Core.ViewModels;assembly=PingPongStats.Core"
        xmlns:views="clr-namespace:PingPongStats.App.Views"
        xmlns:controls="clr-namespace:PingPongStats.App.Controls"
        Title="PingPongStats"
        Width="1200" Height="800"
        MinWidth="900" MinHeight="600"
        Background="{DynamicResource Brush.Deep}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlayersViewModel}">
            <views:PlayersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MatchesViewModel}">
            <views:MatchesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MatchEditViewModel}">
            <views:MatchEditView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DoublesViewModel}">
            <views:DoublesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HeadToHeadViewModel}">
            <views:HeadToHeadView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
            <views:ProfileView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LeagueViewModel}">
            <views:LeagueView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TournamentViewModel}">
            <views:TournamentView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BettingViewModel}">
            <views:BettingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HallOfFameViewModel}">
            <views:HallOfFameView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
    <Grid x:Name="RootScaleHost">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScaleTransform" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Rail (mockup .rail): brand, primary nav (mockup pages), a second
             "Verwaltung" nav group for app features the mockup doesn't show
             (Spieler/Spiele/Doppel/Head-to-Head/Einstellungen - the mockup is
             a partial demo, not the full app; see ABWEICHUNGEN.md), then the
             logged-in player + logout pinned to the bottom. -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,20,14,20">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,6,22">
                    <Ellipse Width="22" Height="22">
                        <Ellipse.Fill>
                            <RadialGradientBrush Center="0.32,0.3" GradientOrigin="0.32,0.3" RadiusX="0.85" RadiusY="0.85">
                                <GradientStop Color="#FFC48A" Offset="0" />
                                <GradientStop Color="{StaticResource Color.Ball}" Offset="0.62" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <DropShadowEffect Color="{StaticResource Color.Ball}" Opacity="0.5" BlurRadius="14" ShadowDepth="0" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock FontFamily="{DynamicResource Font.Display}" FontWeight="ExtraBold" FontSize="23"
                               VerticalAlignment="Center" Margin="9,0,0,0">
                        <Run Text="PING" Foreground="{DynamicResource Brush.Chalk}" />
                        <Run Text="PONG" Foreground="{DynamicResource Brush.Ball}" />
                    </TextBlock>
                </StackPanel>

                <!-- rail-foot (mockup .rail-foot): logged-in player + logout,
                     or a compact "Anmelden" prompt when nobody is logged in. -->
                <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                        <StackPanel Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Margin="4,0,4,6">
                                <controls:AvatarControl Player="{Binding CurrentPlayer}" DataPath="{Binding Dashboard.DataPath}" Size="S" />
                                <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentPlayer.DisplayName}" FontWeight="Bold" FontSize="13.5" />
                                    <TextBlock Text="{Binding Profile.EloLabel, StringFormat='Elo {0}'}"
                                               FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                                               Foreground="{DynamicResource Brush.Ball}" />
                                </StackPanel>
                            </StackPanel>
                            <Button Content="Abmelden" Command="{Binding LogoutCommand}" HorizontalAlignment="Left"
                                    FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" Padding="4,2"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                                        <Setter Property="TextBlock.TextDecorations" Value="Underline" />
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Button Content="Anmelden" Style="{StaticResource SecondaryButton}" Command="{Binding ShowLoginCommand}"
                            HorizontalAlignment="Stretch" Margin="0,14,0,0"
                            Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel>
                            <Button Command="{Binding ShowDashboardCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveSection}" Value="Dashboard">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Table}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x25E7;" Width="16" TextAlignment="Center" Opacity="0.85" />
                                    <TextBlock Text="Dashboard" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ShowProfileCommand}"
                                    Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveSection}" Value="Mein Profil">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Table}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x25C9;" Width="16" TextAlignment="Center" Opacity="0.85" />
                                    <TextBlock Text="Mein Profil" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ShowLeagueCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveSection}" Value="Liga">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Table}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x25A4;" Width="16" TextAlignment="Center" Opacity="0.85" />
                                    <TextBlock Text="Liga" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ShowTournamentCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveSection}" Value="Turnier">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Table}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x2442;" Width="16" TextAlignment="Center" Opacity="0.85" />
                                    <TextBlock Text="Turnier" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ShowHallOfFameCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveSection}" Value="Hall of Fame">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Table}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x2605;" Width="16" TextAlignment="Center" Opacity="0.85" />
                                    <TextBlock Text="Hall of Fame" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ShowBettingCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveSection}" Value="Tippspiel">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Table}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x25C6;" Width="16" TextAlignment="Center" Opacity="0.85" />
                                    <TextBlock Text="Tippspiel" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource Brush.Line}" Margin="6,12" />
                        <TextBlock Style="{StaticResource Typo.Eyebrow}" Text="VERWALTUNG" Margin="10,0,0,6" />

                        <StackPanel>
                            <Button Content="Spieler" Style="{StaticResource NavButton}" Command="{Binding ShowPlayersCommand}" />
                            <Button Content="Spiele" Style="{StaticResource NavButton}" Command="{Binding ShowMatchesCommand}" />
                            <Button Content="Doppel" Style="{StaticResource NavButton}" Command="{Binding ShowDoublesCommand}" />
                            <Button Content="Head-to-Head" Style="{StaticResource NavButton}" Command="{Binding ShowHeadToHeadCommand}" />
                            <Button Content="Einstellungen" Style="{StaticResource NavButton}" Command="{Binding ShowSettingsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Topbar (mockup .topbar): page title, the shared time-range
                 segmented control (applies to Dashboard/Doppel), the primary
                 "+ Spiel erfassen" CTA. -->
            <Border Grid.Row="0" Background="{DynamicResource Brush.Deep}"
                    BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1"
                    Padding="26,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding ActiveSection}" Style="{StaticResource Typo.H1}"
                               VerticalAlignment="Center" />

                    <Border Grid.Column="1" Style="{StaticResource SegmentGroupBorder}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="7T"
                                    Command="{Binding SelectRangeCommand}" CommandParameter="{x:Static vm:DashboardRangePreset.Last7Days}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RangeFilter.SelectedPreset}" Value="Last7Days">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Table}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="30T"
                                    Command="{Binding SelectRangeCommand}" CommandParameter="{x:Static vm:DashboardRangePreset.Last30Days}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RangeFilter.SelectedPreset}" Value="Last30Days">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Table}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="90T"
                                    Command="{Binding SelectRangeCommand}" CommandParameter="{x:Static vm:DashboardRangePreset.Last90Days}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RangeFilter.SelectedPreset}" Value="Last90Days">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Table}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Alle"
                                    Command="{Binding SelectRangeCommand}" CommandParameter="{x:Static vm:DashboardRangePreset.AllTime}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RangeFilter.SelectedPreset}" Value="AllTime">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Table}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="3" Content="&#x27F3;" FontSize="16" ToolTip="Aktualisieren"
                            Style="{StaticResource RefreshIconButton}"
                            Command="{Binding RefreshCommand}" />

                    <Button Grid.Column="5" Content="+ Spiel erfassen" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ShowNewMatchCommand}" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{Binding IsErrorStatus, Converter={StaticResource StatusBackgroundConverter}}"
                    Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"
                    Padding="26,10">
                <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold"
                           Foreground="{Binding IsErrorStatus, Converter={StaticResource StatusForegroundConverter}}" />
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding CurrentViewModel}" Margin="26,22,26,60" />
            </ScrollViewer>
        </Grid>
    </Grid>

    <!-- Sieg-Overlay (mockup .win): fullscreen dark scrim, XL avatar(s) with
         the orange ring AvatarControl already draws at Size="XL", Display
         52px name, italic quote, Rubber COMEBACK badge, ping-pong-ball
         confetti (MainWindow.xaml.cs). Dismissible by clicking anywhere,
         auto-hidden after ~3s by MainViewModel.IsWinAnimationVisible - which
         is only ever set when Settings.ShowWinAnimation is on, so that
         existing setting already doubles as this overlay's reduced-motion
         toggle (see ABWEICHUNGEN.md). -->
    <Border x:Name="WinAnimationOverlay" Background="#E6041117"
            Visibility="{Binding IsWinAnimationVisible, Converter={StaticResource BoolToVisibilityConverter}}"
            IsVisibleChanged="OnWinAnimationOverlayIsVisibleChanged"
            MouseLeftButtonDown="OnWinAnimationOverlayClick">
        <Grid>
            <Canvas x:Name="ConfettiCanvas" IsHitTestVisible="False" ClipToBounds="True" />

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Phase 12: bigger trophy treatment when this win completed a
                     tournament, shown above the normal win overlay content. -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,10"
                            Visibility="{Binding WinAnimationIsTournamentFinal, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="🏆" FontSize="56" HorizontalAlignment="Center" />
                    <TextBlock Text="TURNIERSIEGER!" FontFamily="{DynamicResource Font.Display}" FontWeight="ExtraBold"
                               FontSize="30" Foreground="{DynamicResource Brush.Ball}" HorizontalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="SIEGER" FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                           Foreground="{DynamicResource Brush.Ball}" HorizontalAlignment="Center" Margin="0,0,0,8" />

                <StackPanel HorizontalAlignment="Center"
                            Visibility="{Binding WinAnimationIsDoubles, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <controls:AvatarControl Player="{Binding WinAnimationPlayer1}" DataPath="{Binding Dashboard.DataPath}"
                                             Size="XL" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding WinAnimationPlayer1.DisplayName}" Style="{StaticResource Typo.WinName}"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,16,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Visibility="{Binding WinAnimationIsDoubles, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Margin="0,0,20,0">
                        <controls:AvatarControl Player="{Binding WinAnimationPlayer1}" DataPath="{Binding Dashboard.DataPath}"
                                                 Size="XL" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding WinAnimationPlayer1.DisplayName}" FontFamily="{DynamicResource Font.Display}"
                                   FontWeight="ExtraBold" FontSize="30" Foreground="{DynamicResource Brush.Chalk}"
                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,14,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <controls:AvatarControl Player="{Binding WinAnimationPlayer2}" DataPath="{Binding Dashboard.DataPath}"
                                                 Size="XL" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding WinAnimationPlayer2.DisplayName}" FontFamily="{DynamicResource Font.Display}"
                                   FontWeight="ExtraBold" FontSize="30" Foreground="{DynamicResource Brush.Chalk}"
                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,14,0,0" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{Binding WinAnimationScoreLabel}" FontFamily="{DynamicResource Font.Mono}" FontSize="20"
                           Foreground="{DynamicResource Brush.Chalk}" HorizontalAlignment="Center" Margin="0,10,0,0" />

                <Border Background="{DynamicResource Brush.Rubber}" CornerRadius="6" Padding="14,5" Margin="0,14,0,0"
                        HorizontalAlignment="Center"
                        Visibility="{Binding WinAnimationIsComeback, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="COMEBACK!" FontFamily="{DynamicResource Font.Display}" FontWeight="ExtraBold" FontSize="17"
                               Foreground="White" />
                </Border>

                <TextBlock Text="{Binding WinAnimationQuote}" FontSize="15" FontStyle="Italic" Foreground="#BEDCE4"
                           HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="330" TextAlignment="Center"
                           Margin="0,16,0,0"
                           Visibility="{Binding WinAnimationQuote, Converter={StaticResource StringToVisibilityConverter}}" />

                <TextBlock Text="Tippen zum Schliessen · abschaltbar in den Einstellungen" FontFamily="{DynamicResource Font.Mono}"
                           FontSize="10.5" Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Center" Margin="0,26,0,0" />
            </StackPanel>
        </Grid>
    </Border>
    </Grid>
</Window>
