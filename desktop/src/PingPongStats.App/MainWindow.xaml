<Window x:Class="PingPongStats.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PingPongStats.Core.ViewModels;assembly=PingPongStats.Core"
        xmlns:views="clr-namespace:PingPongStats.App.Views"
        xmlns:controls="clr-namespace:PingPongStats.App.Controls"
        Title="PingPongStats"
        Width="1200" Height="800"
        MinWidth="900" MinHeight="600"
        Background="{DynamicResource Brush.Background}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlayersViewModel}">
            <views:PlayersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MatchesViewModel}">
            <views:MatchesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MatchEditViewModel}">
            <views:MatchEditView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DoublesViewModel}">
            <views:DoublesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HeadToHeadViewModel}">
            <views:HeadToHeadView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
            <views:ProfileView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
    <Grid x:Name="RootScaleHost">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScaleTransform" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar navigation -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <StackPanel Margin="12">
                <TextBlock Text="🏓 PingPongStats" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.TextPrimary}" Margin="8,8,8,20" />

                <Button Content="Dashboard" Style="{StaticResource NavButton}" Command="{Binding ShowDashboardCommand}" />
                <Button Content="Spieler" Style="{StaticResource NavButton}" Command="{Binding ShowPlayersCommand}" />
                <Button Content="Spiele" Style="{StaticResource NavButton}" Command="{Binding ShowMatchesCommand}" />
                <Button Content="Neues Spiel" Style="{StaticResource NavButton}" Command="{Binding ShowNewMatchCommand}" />
                <Button Content="Doppel" Style="{StaticResource NavButton}" Command="{Binding ShowDoublesCommand}" />
                <Button Content="Head-to-Head" Style="{StaticResource NavButton}" Command="{Binding ShowHeadToHeadCommand}" />
                <Button Content="Einstellungen" Style="{StaticResource NavButton}" Command="{Binding ShowSettingsCommand}" />
                <Button Content="Mein Profil" Style="{StaticResource NavButton}" Command="{Binding ShowProfileCommand}"
                        Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Button Content="Anmelden" Style="{StaticResource NavButton}" Command="{Binding ShowLoginCommand}"
                        Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
            </StackPanel>
        </Border>

        <!-- Content area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                    Padding="16,8">
                <Grid>
                    <TextBlock Text="Nicht angemeldet" Style="{StaticResource StatLabelText}" HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibilityConverter}}">
                        <controls:AvatarControl Player="{Binding CurrentPlayer}" DataPath="{Binding Dashboard.DataPath}" Size="S" />
                        <TextBlock Text="{Binding CurrentPlayer.DisplayName}" VerticalAlignment="Center" Margin="8,0,12,0" />
                        <Button Content="Abmelden" Style="{StaticResource CompactSecondaryButton}" Command="{Binding LogoutCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{Binding IsErrorStatus, Converter={StaticResource StatusBackgroundConverter}}"
                    Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"
                    Padding="16,10">
                <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold"
                           Foreground="{Binding IsErrorStatus, Converter={StaticResource StatusForegroundConverter}}" />
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="24">
                <ContentControl Content="{Binding CurrentViewModel}" />
            </ScrollViewer>
        </Grid>
    </Grid>

    <!-- Phase 6 win/confetti overlay: sits above everything else in this outer
         Grid, dismissible by clicking anywhere, auto-hidden after ~3s by
         MainViewModel.IsWinAnimationVisible. -->
    <Border x:Name="WinAnimationOverlay" Background="#CC0F172A"
            Visibility="{Binding IsWinAnimationVisible, Converter={StaticResource BoolToVisibilityConverter}}"
            IsVisibleChanged="OnWinAnimationOverlayIsVisibleChanged"
            MouseLeftButtonDown="OnWinAnimationOverlayClick">
        <Grid>
            <Canvas x:Name="ConfettiCanvas" IsHitTestVisible="False" ClipToBounds="True" />

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center"
                            Visibility="{Binding WinAnimationIsDoubles, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <controls:AvatarControl Player="{Binding WinAnimationPlayer1}" DataPath="{Binding Dashboard.DataPath}"
                                             Size="L" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding WinAnimationPlayer1.DisplayName}" FontSize="24" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" Margin="0,16,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Visibility="{Binding WinAnimationIsDoubles, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Margin="0,0,24,0">
                        <controls:AvatarControl Player="{Binding WinAnimationPlayer1}" DataPath="{Binding Dashboard.DataPath}"
                                                 Size="L" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding WinAnimationPlayer1.DisplayName}" FontSize="18" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <controls:AvatarControl Player="{Binding WinAnimationPlayer2}" DataPath="{Binding Dashboard.DataPath}"
                                                 Size="L" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding WinAnimationPlayer2.DisplayName}" FontSize="18" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{Binding WinAnimationScoreLabel}" FontSize="32" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center" Margin="0,16,0,0" />

                <Border Background="{DynamicResource Brush.Accent}" CornerRadius="6" Padding="16,6" Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Visibility="{Binding WinAnimationIsComeback, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="COMEBACK!" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentText}" />
                </Border>
            </StackPanel>
        </Grid>
    </Border>
    </Grid>
</Window>
