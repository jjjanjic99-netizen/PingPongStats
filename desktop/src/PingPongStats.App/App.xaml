<Application x:Class="PingPongStats.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Styles.xaml merges DesignTokens.xaml and Controls.xaml itself
                     (see its own MergedDictionaries) so this stays a single entry
                     point; nested merges still fully flatten for DynamicResource/
                     FindResource lookups at runtime. -->
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
