<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ══════════════════════════════════════════════════════════════════
         Phase D1: design tokens, transcribed exactly from
         desktop/design/mockup.html's :root custom properties. This is the
         single, fixed dark palette the whole app now uses - the mockup
         defines no light variant, so (per ABWEICHUNGEN.md) the existing
         Dark/Light theme switch keeps working technically but both options
         now resolve to these same tokens.
         ══════════════════════════════════════════════════════════════════ -->

    <!-- ── Mockup colors (exact hex from :root) ─────────────────────────── -->
    <Color x:Key="Color.Deep">#071B24</Color>
    <Color x:Key="Color.Panel">#0D2B37</Color>
    <Color x:Key="Color.Panel2">#113745</Color>
    <Color x:Key="Color.Table">#0D5A6E</Color>
    <Color x:Key="Color.Line">#1E5265</Color>
    <Color x:Key="Color.Ball">#FF7A1A</Color>
    <Color x:Key="Color.Rubber">#D8342A</Color>
    <Color x:Key="Color.Chalk">#EEF4F3</Color>
    <Color x:Key="Color.Muted">#79A2AF</Color>
    <Color x:Key="Color.Win">#3FCF8E</Color>
    <Color x:Key="Color.Lose">#E4675E</Color>

    <SolidColorBrush x:Key="Brush.Deep" Color="{StaticResource Color.Deep}" />
    <SolidColorBrush x:Key="Brush.Panel" Color="{StaticResource Color.Panel}" />
    <SolidColorBrush x:Key="Brush.Panel2" Color="{StaticResource Color.Panel2}" />
    <SolidColorBrush x:Key="Brush.Table" Color="{StaticResource Color.Table}" />
    <SolidColorBrush x:Key="Brush.Line" Color="{StaticResource Color.Line}" />
    <SolidColorBrush x:Key="Brush.Ball" Color="{StaticResource Color.Ball}" />
    <SolidColorBrush x:Key="Brush.Rubber" Color="{StaticResource Color.Rubber}" />
    <SolidColorBrush x:Key="Brush.Chalk" Color="{StaticResource Color.Chalk}" />
    <SolidColorBrush x:Key="Brush.Muted" Color="{StaticResource Color.Muted}" />
    <SolidColorBrush x:Key="Brush.Win" Color="{StaticResource Color.Win}" />
    <SolidColorBrush x:Key="Brush.Lose" Color="{StaticResource Color.Lose}" />

    <!-- Mockup's CTA/orange-chip text color (#08222C, a near-black teal used
         as foreground ON TOP of Ball-colored surfaces for contrast). -->
    <SolidColorBrush x:Key="Brush.OnBall" Color="#08222C" />

    <!-- ── Legacy Brush.* aliases ────────────────────────────────────────
         Every existing View still binds to these keys (Brush.Background,
         Brush.Accent, ...) from before this redesign. Rather than touching
         every single XAML file, they are re-pointed at the new mockup
         tokens here so the whole app converges on the new palette even
         where a view hasn't been individually rebuilt yet (see
         ABWEICHUNGEN.md, "Scope von Phase D4"). -->
    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Deep}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Panel}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Line}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.Chalk}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.Muted}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Ball}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FF9248" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#08222C" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Win}" />
    <SolidColorBrush x:Key="Brush.SuccessSurface" Color="#173C33" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Lose}" />
    <SolidColorBrush x:Key="Brush.DangerSurface" Color="#3B1C1C" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Rubber}" />
    <SolidColorBrush x:Key="Brush.WarningSurface" Color="#3B1C1C" />
    <SolidColorBrush x:Key="Brush.NavHover" Color="{StaticResource Color.Panel2}" />
    <SolidColorBrush x:Key="Brush.InputBackground" Color="{StaticResource Color.Deep}" />
    <SolidColorBrush x:Key="Brush.RowAlternate" Color="{StaticResource Color.Panel2}" />

    <!-- ── Fonts ─────────────────────────────────────────────────────────
         Comma-separated fallback strings: WPF's built-in font-family-list
         fallback tries each name in order, so a missing/empty
         Assets/Fonts/ folder degrades to Segoe UI instead of crashing -
         see Assets/Fonts/README.md. -->
    <FontFamily x:Key="Font.Display">pack://application:,,,/Assets/Fonts/#Big Shoulders Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Body">pack://application:,,,/Assets/Fonts/#Space Grotesk, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">pack://application:,,,/Assets/Fonts/#JetBrains Mono, Consolas, Segoe UI</FontFamily>

    <!-- ── Typography scale (exact px/letter-spacing from the mockup) ───── -->
    <!-- letter-spacing 0.5px @ 30px ≈ CharacterSpacing 17 (1000ths of font size,
         WPF's own unit for TextBlock.CharacterSpacing - added .NET Core 3.0+). -->
    <Style x:Key="Typo.H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="CharacterSpacing" Value="17" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Chalk}" />
    </Style>

    <Style x:Key="Typo.HeroName" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontSize" Value="44" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Chalk}" />
    </Style>

    <!-- Sieg-Overlay Spielername: 52px laut Mockup's .win-name, größer als
         der normale Hero-Name (44px). -->
    <Style x:Key="Typo.WinName" TargetType="TextBlock" BasedOn="{StaticResource Typo.HeroName}">
        <Setter Property="FontSize" Value="52" />
    </Style>

    <Style x:Key="Typo.BigStat" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontSize" Value="42" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Chalk}" />
    </Style>

    <Style x:Key="Typo.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Chalk}" />
    </Style>

    <Style x:Key="Typo.Small" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
    </Style>

    <!-- WPF has no CSS text-transform:uppercase for arbitrary bound text, so
         actual upper-casing happens in code (see EyebrowLabel, Phase D3) -
         this style only sets font/size/color/tracking. -->
    <Style x:Key="Typo.Eyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="CharacterSpacing" Value="152" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
    </Style>

    <!-- ── Radii ─────────────────────────────────────────────────────────
         CornerRadius resources: cards 12px, buttons/inputs 8px, pills 20px. -->
    <CornerRadius x:Key="Radius.Card">12</CornerRadius>
    <CornerRadius x:Key="Radius.Control">8</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">20</CornerRadius>

    <!-- ── Spacing (4px grid) ────────────────────────────────────────────── -->
    <Thickness x:Key="Spacing.CardPadding">16,18,16,18</Thickness>
    <sys:Double x:Key="Spacing.GridGap">14</sys:Double>

</ResourceDictionary>
