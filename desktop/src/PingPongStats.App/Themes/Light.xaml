<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Phase D1: the mockup (desktop/design/mockup.html) defines a single,
         fixed dark palette with no light variant. All actual colors now live
         in DesignTokens.xaml; this dictionary only merges it so the existing
         Settings "Dark Mode" toggle and ThemeManager plumbing keep working
         (see desktop/design/ABWEICHUNGEN.md) without behaving any
         differently from Dark.xaml. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DesignTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
