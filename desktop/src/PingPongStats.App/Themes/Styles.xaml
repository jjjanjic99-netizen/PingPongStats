<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:PingPongStats.App.Converters">

    <!-- StaticResource lookups only see the CURRENT dictionary plus whatever
         it merges itself (not sibling dictionaries merged alongside it at the
         App.xaml level) - this file's own Styles reference Typo.*/Color.*
         (DesignTokens.xaml) and CompactDangerButton (Controls.xaml) via
         StaticResource, so both are merged in here directly rather than
         relying on App.xaml's merge order. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DesignTokens.xaml" />
        <ResourceDictionary Source="Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- All app-wide converters live here (not in App.xaml) so every StaticResource
         reference to them from within this same file resolves at parse time -
         a ResourceDictionary cannot see sibling merged dictionaries' keys via
         StaticResource, only its own. -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
    <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    <converters:StatusBackgroundConverter x:Key="StatusBackgroundConverter" />
    <converters:StatusForegroundConverter x:Key="StatusForegroundConverter" />
    <converters:BarHeightConverter x:Key="BarHeightConverter" />
    <converters:StringEqualsConverter x:Key="StringEqualsConverter" />
    <converters:FractionToPixelConverter x:Key="XPixelConverter" InvertForYAxis="False" />
    <converters:FractionToPixelConverter x:Key="YPixelConverter" InvertForYAxis="True" />
    <converters:EloPointsToPolylineConverter x:Key="EloPointsToPolylineConverter" />

    <!-- Shared bar-chart item template/panel, used by Dashboard and Doubles views
         so both render identical hand-rolled bar charts without duplicating XAML.
         Table→Ball gradient fill, matching the mockup's .bar-fill. -->
    <LinearGradientBrush x:Key="Brush.BarGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource Color.Table}" Offset="0" />
        <GradientStop Color="{StaticResource Color.Ball}" Offset="1" />
    </LinearGradientBrush>

    <DataTemplate x:Key="ChartBarItemTemplate">
        <StackPanel Width="55" Margin="3,0" VerticalAlignment="Bottom">
            <TextBlock Text="{Binding DisplayValue}" HorizontalAlignment="Center"
                       FontFamily="{DynamicResource Font.Mono}"
                       Foreground="{DynamicResource Brush.Muted}" FontSize="11" />
            <Border Background="{StaticResource Brush.BarGradient}" CornerRadius="3,3,0,0"
                    Height="{Binding NormalizedHeight, Converter={StaticResource BarHeightConverter}, ConverterParameter=140}" />
            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" TextWrapping="Wrap"
                       FontSize="10" Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,0" />
        </StackPanel>
    </DataTemplate>
    <ItemsPanelTemplate x:Key="ChartItemsPanel">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Height="200" />
    </ItemsPanelTemplate>

    <!-- Mockup .card: Panel fill, 1px Line border, 12px radius. The signature
         bottom "table line" gradient (Phase D3's CardControl) isn't available
         on a plain Border (a Border/Decorator can't host the extra visual) -
         views not yet migrated to CardControl keep this flatter look; see
         desktop/design/ABWEICHUNGEN.md. -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}" />
        <Setter Property="Padding" Value="{DynamicResource Spacing.CardPadding}" />
    </Style>

    <!-- Page titles (mockup .page-title / Typo.H1: Display ExtraBold 30px). -->
    <Style x:Key="HeadingText" TargetType="TextBlock" BasedOn="{StaticResource Typo.H1}" />

    <!-- Card section headers (mockup .eyebrow: mono, small, tracked, muted -
         text case itself is authored per call site, WPF can't transform bound
         text declaratively; see EyebrowLabel, Phase D3, for the cases where a
         control does it in code). -->
    <Style x:Key="SectionLabelText" TargetType="TextBlock" BasedOn="{StaticResource Typo.Eyebrow}" />

    <!-- Large standalone stat numbers (mockup's 42px "grosse Kennzahl"). Many
         call sites already override FontSize/Foreground inline for their
         specific context. -->
    <Style x:Key="StatValueText" TargetType="TextBlock" BasedOn="{StaticResource Typo.BigStat}">
        <Setter Property="FontSize" Value="32" />
    </Style>

    <Style x:Key="StatLabelText" TargetType="TextBlock" BasedOn="{StaticResource Typo.Small}" />

    <!-- Implicit (keyless) default so every plain TextBlock without an explicit
         Style still gets the mockup's body font/color instead of the system
         default (Segoe UI black). -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Chalk}" />
    </Style>

    <!-- Shared optional set-score entry row, used by MatchEditView and DoublesView.
         Relies on the hosting UserControl exposing a RemoveSetCommand with this
         exact name (both MatchEditViewModel and DoublesViewModel do). -->
    <DataTemplate x:Key="SetResultEntryTemplate">
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding SetNumber, StringFormat='Satz {0}'}"
                       VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}" />
            <TextBox Grid.Column="1" Text="{Binding PointsA, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Grid.Column="3" Text="{Binding PointsB, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="5" Content="Entfernen" Style="{StaticResource CompactDangerButton}"
                    Command="{Binding DataContext.RemoveSetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" />
        </Grid>
    </DataTemplate>

</ResourceDictionary>
