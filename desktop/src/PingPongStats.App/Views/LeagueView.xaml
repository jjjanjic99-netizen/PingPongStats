<UserControl x:Class="PingPongStats.App.Views.LeagueView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PingPongStats.App.Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <StackPanel>
        <controls:CardControl Visibility="{Binding HasActiveSeason, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <TextBlock Text="Keine aktive Saison. Eine Saison kann unter Einstellungen angelegt und aktiviert werden."
                       Style="{StaticResource Typo.Body}" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" />
        </controls:CardControl>

        <controls:CardControl Visibility="{Binding HasActiveSeason, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <controls:EyebrowLabel Text="{Binding ActiveSeasonLabel}" />

                <!-- Podium (mockup .podium): 2nd/1st/3rd order, 1st tallest and
                     Ball-accented. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <ItemsControl ItemsSource="{Binding Podium}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center" Margin="7,0" Width="82">
                                    <controls:AvatarControl Player="{Binding Player}"
                                                             DataPath="{Binding ElementName=Root, Path=DataContext.DataPath}"
                                                             Size="M" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12.5" HorizontalAlignment="Center"
                                               Margin="0,7,0,0" TextWrapping="Wrap" TextAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Rank}" Value="1">
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border CornerRadius="9,9,0,0" Margin="0,7,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Height" Value="66" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="{StaticResource Color.Panel2}" Offset="0" />
                                                            <GradientStop Color="{StaticResource Color.Panel}" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Rank}" Value="1">
                                                        <Setter Property="Height" Value="92" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ball}" />
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#47FF7A1A" Offset="0" />
                                                                    <GradientStop Color="{StaticResource Color.Panel}" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Rank}" Value="3">
                                                        <Setter Property="Height" Value="50" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Rank}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontFamily="{DynamicResource Font.Display}" FontWeight="ExtraBold" FontSize="28">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Rank}" Value="1">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Ball}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Einzel/Doppel segmented toggle (mockup .range, reused). -->
                <Border Style="{StaticResource SegmentGroupBorder}" HorizontalAlignment="Center" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Einzel" Command="{Binding SetDoublesModeCommand}">
                            <Button.CommandParameter>
                                <sys:Boolean>False</sys:Boolean>
                            </Button.CommandParameter>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDoublesMode}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Table}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Doppel" Command="{Binding SetDoublesModeCommand}">
                            <Button.CommandParameter>
                                <sys:Boolean>True</sys:Boolean>
                            </Button.CommandParameter>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDoublesMode}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Table}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- League table (mockup .row list): pos, avatar, name,
                     SP/S-N/SD/PKT columns. More detail than the mockup's plain
                     table (which also shows S/N and SD) - kept as-is, this is
                     already close to a 1:1 match. -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="11" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="11" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="4" Text="Spieler" FontFamily="{DynamicResource Font.Mono}" FontSize="10.5"
                               Foreground="{DynamicResource Brush.Muted}" />
                    <TextBlock Grid.Column="5" Text="SP" FontFamily="{DynamicResource Font.Mono}" FontSize="10.5"
                               Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="6" Text="S/N" FontFamily="{DynamicResource Font.Mono}" FontSize="10.5"
                               Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="7" Text="SD" FontFamily="{DynamicResource Font.Mono}" FontSize="10.5"
                               Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="8" Text="PKT" FontFamily="{DynamicResource Font.Mono}" FontSize="10.5"
                               Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Right" />
                </Grid>
                <Border Height="1" Background="{DynamicResource Brush.Line}" Margin="0,6,0,4" />
                <ItemsControl ItemsSource="{Binding Table}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="11" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="11" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Rank}" FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="12" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
                                <controls:AvatarControl Grid.Column="2" Player="{Binding Player}"
                                                         DataPath="{Binding ElementName=Root, Path=DataContext.DataPath}"
                                                         Size="S" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding DisplayName}" FontWeight="Medium" FontSize="14"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="5" Text="{Binding Played}" FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="6" FontFamily="{DynamicResource Font.Mono}" FontSize="13"
                                           HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Run Text="{Binding Wins, Mode=OneWay}" />
                                    <Run Text="/" />
                                    <Run Text="{Binding Losses, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Grid.Column="7" Text="{Binding SetDifferenceLabel}" FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Win}" />
                                <TextBlock Grid.Column="8" Text="{Binding Points}" FontFamily="{DynamicResource Font.Mono}"
                                           FontWeight="Bold" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Ball}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="3 Punkte pro Sieg · Gleichstand entschieden über Satzdifferenz, dann direkter Vergleich"
                           Style="{StaticResource Typo.Small}" Foreground="{DynamicResource Brush.Muted}" Margin="0,10,0,0" />
            </StackPanel>
        </controls:CardControl>
    </StackPanel>
</UserControl>
