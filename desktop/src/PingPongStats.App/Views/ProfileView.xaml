<UserControl x:Class="PingPongStats.App.Views.ProfileView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PingPongStats.App.Controls">
    <StackPanel>
        <!-- Header card (mockup): L avatar, Display 32px name, mut summary
             line, badge pills. -->
        <controls:CardControl Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <controls:AvatarControl Player="{Binding Player}" DataPath="{Binding DataPath}" Size="L" />
                <StackPanel VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="{Binding Player.DisplayName}" FontFamily="{DynamicResource Font.Display}"
                               FontWeight="ExtraBold" FontSize="32" />
                    <TextBlock Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,0">
                        <Run Text="{Binding EloLabel, StringFormat='Elo {0}', Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding RankLabel, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding Played, Mode=OneWay}" />
                        <Run Text=" Spiele" />
                    </TextBlock>
                    <TextBlock Text="Noch keine Abzeichen verdient." Style="{StaticResource Typo.Small}"
                               Foreground="{DynamicResource Brush.Muted}" Margin="0,10,0,0"
                               Visibility="{Binding HasBadges, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    <ItemsControl ItemsSource="{Binding Badges}" Margin="0,10,0,0"
                                  Visibility="{Binding HasBadges, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Brush.Panel2}" BorderBrush="{DynamicResource Brush.Line}"
                                        BorderThickness="1" CornerRadius="20" Padding="8,6,12,6" Margin="0,0,8,8">
                                    <Border.ToolTip>
                                        <TextBlock MaxWidth="280" TextWrapping="Wrap">
                                            <Run Text="{Binding Description, Mode=OneWay}" />
                                            <LineBreak />
                                            <Run Text="Verdient am: " FontWeight="SemiBold" />
                                            <Run Text="{Binding EarnedAt, StringFormat='dd.MM.yyyy', Mode=OneWay}" />
                                        </TextBlock>
                                    </Border.ToolTip>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding BadgeName}" FontSize="12.5" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </controls:CardControl>

        <!-- Siegquote / Längste Serie / Satzdifferenz (mockup g3) -->
        <UniformGrid Rows="1" Columns="3" Margin="0,0,0,14">
            <controls:StatTile Label="Siegquote" Value="{Binding WinRateLabel}" SubText="{Binding Played, StringFormat='{}{0} Spiele'}"
                                ValueBrush="{DynamicResource Brush.Ball}" Margin="0,0,10,0" />
            <controls:StatTile Label="Längste Serie" Value="{Binding LongestWinStreakLabel}" Margin="0,0,10,0" />
            <controls:StatTile Label="Satzdifferenz" Value="{Binding SetDifferenceLabel}" ValueBrush="{DynamicResource Brush.Win}" />
        </UniformGrid>

        <!-- Remaining stats (Spiele/Siege/Niederlagen/Serien) - not in the
             mockup's 3-tile summary but kept, not dropped (see
             ABWEICHUNGEN.md). -->
        <UniformGrid Rows="1" Columns="4" Margin="0,0,0,14">
            <controls:StatTile Label="Spiele" Value="{Binding Played}" Margin="0,0,10,0" />
            <controls:StatTile Label="Siege" Value="{Binding Wins}" Margin="0,0,10,0" />
            <controls:StatTile Label="Niederlagen" Value="{Binding Losses}" Margin="0,0,10,0" />
            <controls:StatTile Label="Längste Niederlagenserie" Value="{Binding LongestLossStreakLabel}" />
        </UniformGrid>

        <!-- Angstgegner / Lieblingsgegner -->
        <controls:CardControl Margin="0,0,0,14">
            <StackPanel>
                <controls:EyebrowLabel Text="Angstgegner" />
                <Grid Visibility="{Binding HasNemesis, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:AvatarControl Grid.Column="0" Player="{Binding NemesisPlayer}" DataPath="{Binding DataPath}" Size="M" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NemesisDisplayName}" FontWeight="Bold" />
                        <TextBlock Style="{StaticResource Typo.Small}" Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,0">
                            <Run Text="Bilanz " />
                            <Run Text="{Binding NemesisRecordLabel, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <controls:Pill Grid.Column="3" Text="😰" Variant="Bad" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="Noch zu wenig Spiele." Style="{StaticResource Typo.Small}" Foreground="{DynamicResource Brush.Muted}"
                           Visibility="{Binding HasNemesis, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                <Border Height="1" Background="{DynamicResource Brush.Line}" Margin="0,14" />

                <controls:EyebrowLabel Text="Lieblingsgegner" />
                <Grid Visibility="{Binding HasFavoriteOpponent, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:AvatarControl Grid.Column="0" Player="{Binding FavoriteOpponentPlayer}" DataPath="{Binding DataPath}" Size="M" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FavoriteOpponentDisplayName}" FontWeight="Bold" />
                        <TextBlock Style="{StaticResource Typo.Small}" Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,0">
                            <Run Text="Bilanz " />
                            <Run Text="{Binding FavoriteOpponentRecordLabel, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <controls:Pill Grid.Column="3" Text="😎" Variant="Win" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="Noch zu wenig Spiele." Style="{StaticResource Typo.Small}" Foreground="{DynamicResource Brush.Muted}"
                           Visibility="{Binding HasFavoriteOpponent, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
            </StackPanel>
        </controls:CardControl>

        <!-- Bilanz-Countdown: no opponent Player object is available here
             (StatsService only returns a display name), so rows show no
             avatar rather than fabricate one - matching the Dashboard
             Comeback card's precedent (see ABWEICHUNGEN.md). -->
        <controls:CardControl Margin="0,0,0,14">
            <StackPanel>
                <controls:EyebrowLabel Text="Bilanz-Countdown" />
                <TextBlock Text="Noch keine Gegner mit genügend Spielen." Style="{StaticResource Typo.Small}"
                           Foreground="{DynamicResource Brush.Muted}"
                           Visibility="{Binding HasBalanceCountdowns, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                <ItemsControl ItemsSource="{Binding BalanceCountdowns}"
                              Visibility="{Binding HasBalanceCountdowns, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:RowItem NameText="{Binding OpponentDisplayName}" ValueText="{Binding StatusLabel}" AvatarDataPath="{Binding ElementName=Root, Path=DataContext.DataPath}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </controls:CardControl>

        <!-- Siegquote nach Tageszeit (mockup .bar-row list) -->
        <controls:CardControl Margin="0,0,0,14">
            <StackPanel>
                <controls:EyebrowLabel Text="Siegquote nach Tageszeit" />
                <ItemsControl ItemsSource="{Binding TimeOfDayChart}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:BarRow LabelText="{Binding Label}" ValueText="{Binding DisplayValue}"
                                              NormalizedValue="{Binding NormalizedHeight}" IsDim="{Binding IsLowSample}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding BestTimeOfDayLabel}" Style="{StaticResource Typo.Small}" Foreground="{DynamicResource Brush.Muted}"
                           Margin="0,8,0,0" TextWrapping="Wrap"
                           Visibility="{Binding HasBestTimeOfDay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </controls:CardControl>

        <!-- Elo-Verlauf: existing hand-rolled polyline chart, unchanged
             internally, just wrapped in CardControl. -->
        <controls:CardControl>
            <StackPanel>
                <controls:EyebrowLabel Text="Elo-Verlauf" />
                <TextBlock Text="Noch keine Spiele mit Elo-Verlauf erfasst." Style="{StaticResource Typo.Small}"
                           Foreground="{DynamicResource Brush.Muted}"
                           Visibility="{Binding HasEloHistory, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                <Grid Width="600" Height="160" HorizontalAlignment="Left"
                      Visibility="{Binding HasEloHistory, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Canvas Width="600" Height="160">
                        <Polyline Points="{Binding EloHistoryChart, Converter={StaticResource EloPointsToPolylineConverter}, ConverterParameter='600,160'}"
                                  Stroke="{DynamicResource Brush.Ball}" StrokeThickness="2" />
                    </Canvas>
                    <ItemsControl ItemsSource="{Binding EloHistoryChart}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Width="600" Height="160" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left"
                                        Value="{Binding NormalizedX, Converter={StaticResource XPixelConverter}, ConverterParameter=600}" />
                                <Setter Property="Canvas.Top"
                                        Value="{Binding NormalizedY, Converter={StaticResource YPixelConverter}, ConverterParameter=160}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Ball}" Margin="-3,-3,0,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </StackPanel>
        </controls:CardControl>
    </StackPanel>
</UserControl>
