<UserControl x:Class="PingPongStats.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PingPongStats.App.Controls">
    <StackPanel>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Dashboard" Style="{StaticResource HeadingText}" />
            <ComboBox Grid.Column="1" Width="170"
                      ItemsSource="{Binding RangeOptions}" DisplayMemberPath="Label" SelectedValuePath="Preset"
                      SelectedValue="{Binding RangeFilter.SelectedPreset}" />
            <Button Grid.Column="3" Content="Aktualisieren" Style="{StaticResource SecondaryButton}"
                    Command="{Binding RefreshCommand}" />
        </Grid>

        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16"
                Visibility="{Binding HasPlayerOfTheWeek, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <controls:AvatarControl Player="{Binding PlayerOfTheWeek}" DataPath="{Binding DataPath}" Size="L" />
                <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="PLAYER OF THE WEEK" Style="{StaticResource StatLabelText}" />
                    <TextBlock Text="{Binding PlayerOfTheWeek.DisplayName}" Style="{StaticResource HeadingText}" FontSize="20" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding PlayerOfTheWeekRecordLabel}" Style="{StaticResource StatLabelText}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding PlayerOfTheWeekScoreLabel}" Style="{StaticResource StatLabelText}" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16"
                Visibility="{Binding HasPlayerOfTheWeek, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <TextBlock Text="Player of the Week: noch niemand qualifiziert (mindestens 3 Spiele in den letzten 7 Tagen nötig)."
                       Style="{StaticResource StatLabelText}" TextWrapping="Wrap" />
        </Border>

        <UniformGrid Rows="1" Columns="6" Margin="0,0,0,16">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="SPIELE TOTAL" Style="{StaticResource StatLabelText}" />
                    <TextBlock Text="{Binding TotalMatches}" Style="{StaticResource StatValueText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="AKTIVE SPIELER" Style="{StaticResource StatLabelText}" />
                    <TextBlock Text="{Binding ActivePlayerCount}" Style="{StaticResource StatValueText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="MEISTE SIEGE" Style="{StaticResource StatLabelText}" />
                    <TextBlock Text="{Binding MostWinsLabel}" Style="{StaticResource StatValueText}" FontSize="15" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="SIEGQUOTE OVERALL" Style="{StaticResource StatLabelText}" />
                    <TextBlock Text="{Binding HighestOverallWinRateLabel}" Style="{StaticResource StatValueText}" FontSize="15" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="SIEGQUOTE 30 TAGE" Style="{StaticResource StatLabelText}" />
                    <TextBlock Text="{Binding HighestWinRateLastMonthLabel}" Style="{StaticResource StatValueText}" FontSize="15" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="BESTE AKTUELLE SERIE" Style="{StaticResource StatLabelText}" />
                    <TextBlock Text="{Binding BestCurrentStreakLabel}" Style="{StaticResource StatValueText}" FontSize="15" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Siege pro Spieler" Style="{StaticResource SectionLabelText}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding WinsChart}"
                                  ItemsPanel="{StaticResource ChartItemsPanel}"
                                  ItemTemplate="{StaticResource ChartBarItemTemplate}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Siegquote pro Spieler" Style="{StaticResource SectionLabelText}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding WinRateChart}"
                                  ItemsPanel="{StaticResource ChartItemsPanel}"
                                  ItemTemplate="{StaticResource ChartBarItemTemplate}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Spiele pro Woche" Style="{StaticResource SectionLabelText}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding MatchesPerWeekChart}"
                                  ItemsPanel="{StaticResource ChartItemsPanel}"
                                  ItemTemplate="{StaticResource ChartBarItemTemplate}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Grid.Row="1" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Spiele pro Monat" Style="{StaticResource SectionLabelText}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding MatchesPerMonthChart}"
                                  ItemsPanel="{StaticResource ChartItemsPanel}"
                                  ItemTemplate="{StaticResource ChartBarItemTemplate}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource CardBorder}" Padding="0">
            <StackPanel>
                <TextBlock Text="Ranking &amp; Spielerübersicht" Style="{StaticResource SectionLabelText}" Margin="16,16,16,8" />
                <DataGrid ItemsSource="{Binding Ranking}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Bild" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:AvatarControl Player="{Binding Player}"
                                                             DataPath="{Binding DataContext.DataPath, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                             Size="S" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Spieler" Binding="{Binding DisplayName}" Width="140" />
                        <DataGridTextColumn Header="Elo" Binding="{Binding EloRounded}" Width="60" />
                        <DataGridTextColumn Header="Spiele" Binding="{Binding Played}" Width="60" />
                        <DataGridTextColumn Header="S/N" Binding="{Binding RecordLabel}" Width="70" />
                        <DataGridTextColumn Header="Siegquote" Binding="{Binding WinRateLabel}" Width="80" />
                        <DataGridTextColumn Header="Siegquote 30T" Binding="{Binding WinRateLast30dLabel}" Width="100" />
                        <DataGridTextColumn Header="Serie" Binding="{Binding StreakLabel}" Width="70" />
                        <DataGridTextColumn Header="Form (letzte 5)" Binding="{Binding RecentFormLabel}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
