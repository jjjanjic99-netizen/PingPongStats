<UserControl x:Class="PingPongStats.App.Views.DoublesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Doppel" Style="{StaticResource HeadingText}" />
            <ComboBox Grid.Column="1" Width="170"
                      ItemsSource="{Binding RangeOptions}" DisplayMemberPath="Label" SelectedValuePath="Preset"
                      SelectedValue="{Binding RangeFilter.SelectedPreset}" />
            <Button Grid.Column="3" Content="Aktualisieren" Style="{StaticResource SecondaryButton}"
                    Command="{Binding RefreshCommand}" />
            <Button Grid.Column="5" Content="+ Neues Doppel-Spiel" Style="{StaticResource PrimaryButton}"
                    Command="{Binding NewMatchCommand}" />
        </Grid>

        <UniformGrid Rows="1" Columns="2" Margin="0,0,0,16">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="DOPPEL-SPIELE" Style="{StaticResource StatLabelText}" />
                    <TextBlock Text="{Binding TotalDoubleMatches}" Style="{StaticResource StatValueText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="BESTE TEAM-KONSTELLATION" Style="{StaticResource StatLabelText}" />
                    <TextBlock Text="{Binding BestPairingLabel}" Style="{StaticResource StatValueText}" FontSize="15" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Siegquote pro Team-Konstellation" Style="{StaticResource SectionLabelText}" Margin="0,0,0,12" />
                <ItemsControl ItemsSource="{Binding PairingWinRateChart}"
                              ItemsPanel="{StaticResource ChartItemsPanel}"
                              ItemTemplate="{StaticResource ChartBarItemTemplate}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16"
                Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Neues Doppel-Spiel erfassen" Style="{StaticResource SectionLabelText}" Margin="0,0,0,12" />

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="10"
                        Visibility="{Binding IsTournamentMatch, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Turnier-Partie: Die Teams sind durch die Turnierpaarung vorgegeben." TextWrapping="Wrap" />
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="10"
                        Visibility="{Binding IsPendingMatch, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Getippte Partie: Die Teams sind durch die im Tippspiel angelegte Paarung vorgegeben." TextWrapping="Wrap" />
                </Border>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Datum" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding PlayedAtDate}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Uhrzeit (HH:mm)" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding PlayedAtTime, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Team A" Style="{StaticResource SectionLabelText}" Margin="0,0,0,4" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" ItemsSource="{Binding AvailablePlayers}" DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding TeamAPlayer1}" IsEnabled="{Binding ArePlayerSelectorsEnabled}" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding AvailablePlayers}" DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding TeamAPlayer2}" IsEnabled="{Binding ArePlayerSelectorsEnabled}" />
                </Grid>

                <TextBlock Text="Team B" Style="{StaticResource SectionLabelText}" Margin="0,0,0,4" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" ItemsSource="{Binding AvailablePlayers}" DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding TeamBPlayer1}" IsEnabled="{Binding ArePlayerSelectorsEnabled}" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding AvailablePlayers}" DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding TeamBPlayer2}" IsEnabled="{Binding ArePlayerSelectorsEnabled}" />
                </Grid>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="10"
                        Visibility="{Binding HasPrediction, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Prognose:" Style="{StaticResource StatLabelText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding PredictionTeamALabel}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding PredictionTeamBLabel}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Gewinner (für Schnellauswahl)" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton Content="Team A" GroupName="DoublesWinnerSide" Margin="0,0,16,0" VerticalAlignment="Center"
                                 IsChecked="{Binding WinnerSide, Converter={StaticResource StringEqualsConverter}, ConverterParameter=A}" />
                    <RadioButton Content="Team B" GroupName="DoublesWinnerSide" VerticalAlignment="Center"
                                 IsChecked="{Binding WinnerSide, Converter={StaticResource StringEqualsConverter}, ConverterParameter=B}" />
                </StackPanel>

                <TextBlock Text="Schnellauswahl Ergebnis (Sätze Gewinner:Verlierer)" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding QuickResults}" Margin="0,0,0,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding LabelForSideA}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                    Command="{Binding DataContext.ApplyQuickResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Sätze Team A" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding TeamASets, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Sätze Team B" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding TeamBSets, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Satzergebnisse (optional)" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding SetEntries}" ItemTemplate="{StaticResource SetResultEntryTemplate}" Margin="0,0,0,4" />
                <Button Content="+ Satz hinzufügen" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                        Margin="0,0,0,12" Command="{Binding AddSetCommand}" />

                <TextBlock Text="Kommentar / Notiz" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                <TextBlock Text="{Binding FormErrorMessage}" Foreground="{DynamicResource Brush.Danger}"
                           TextWrapping="Wrap" Margin="0,0,0,12"
                           Visibility="{Binding FormErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Abbrechen" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding CancelFormCommand}" />
                    <Button Content="Speichern" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Team-Konstellationen (Ranking)" Style="{StaticResource SectionLabelText}" Margin="16,16,16,8" />
                <DataGrid ItemsSource="{Binding Rankings}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Team" Binding="{Binding PairLabel}" Width="220" />
                        <DataGridTextColumn Header="Spiele" Binding="{Binding Played}" Width="70" />
                        <DataGridTextColumn Header="Siege" Binding="{Binding Wins}" Width="70" />
                        <DataGridTextColumn Header="Niederlagen" Binding="{Binding Losses}" Width="100" />
                        <DataGridTextColumn Header="Siegquote" Binding="{Binding WinRateLabel}" Width="90" />
                        <DataGridTextColumn Header="Hinweis" Binding="{Binding LowSampleLabel}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}" Padding="0">
            <StackPanel>
                <TextBlock Text="Doppel-Spielverlauf" Style="{StaticResource SectionLabelText}" Margin="16,16,16,8" />
                <DataGrid ItemsSource="{Binding Matches}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Datum" Binding="{Binding PlayedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="140" />
                        <DataGridTextColumn Header="Team A" Binding="{Binding TeamALabel}" Width="180" />
                        <DataGridTextColumn Header="Team B" Binding="{Binding TeamBLabel}" Width="180" />
                        <DataGridTextColumn Header="Ergebnis" Binding="{Binding ResultLabel}" Width="80" />
                        <DataGridTextColumn Header="Sieger" Binding="{Binding WinnerLabel}" Width="180" />
                        <DataGridTemplateColumn Header="Aktionen" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Löschen" Style="{StaticResource CompactDangerButton}"
                                            Click="OnDeleteClick" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
