<UserControl x:Class="PingPongStats.App.Views.DoublesView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PingPongStats.App.Controls">
    <StackPanel>
        <!-- No mockup equivalent for "Doppel" as its own page (an app feature
             beyond the six mockup pages, like Spieler/Spiele/Einstellungen -
             see the Shell entry in ABWEICHUNGEN.md). Restyled with the same
             building blocks/colors, structurally unchanged. -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="1" Width="170"
                      ItemsSource="{Binding RangeOptions}" DisplayMemberPath="Label" SelectedValuePath="Preset"
                      SelectedValue="{Binding RangeFilter.SelectedPreset}" />
            <Button Grid.Column="3" Content="+ Neues Doppel-Spiel" Style="{StaticResource PrimaryButton}"
                    Command="{Binding NewMatchCommand}" />
        </Grid>

        <UniformGrid Rows="1" Columns="2" Margin="0,0,0,14">
            <controls:StatTile Label="Doppel-Spiele" Value="{Binding TotalDoubleMatches}" Margin="0,0,10,0" />
            <controls:StatTile Label="Beste Team-Konstellation" Value="{Binding BestPairingLabel}" />
        </UniformGrid>

        <controls:CardControl Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Siegquote pro Team-Konstellation" Style="{StaticResource SectionLabelText}" Margin="0,0,0,12" />
                <ItemsControl ItemsSource="{Binding PairingWinRateChart}"
                              ItemsPanel="{StaticResource ChartItemsPanel}"
                              ItemTemplate="{StaticResource ChartBarItemTemplate}" />
            </StackPanel>
        </controls:CardControl>

        <!-- Embedded match-entry form (mockup .dialog style, same as
             MatchEditView - see ABWEICHUNGEN.md): no table-line, since this
             isn't a .card. -->
        <Border Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                CornerRadius="14" Padding="20" Margin="0,0,0,14"
                Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Neues Doppel-Spiel erfassen" FontFamily="{DynamicResource Font.Display}" FontWeight="Bold"
                           FontSize="26" Margin="0,0,0,16" />

                <Border Background="{DynamicResource Brush.Panel2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Control}" Margin="0,0,0,13" Padding="11"
                        Visibility="{Binding IsTournamentMatch, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Turnier-Partie: Die Teams sind durch die Turnierpaarung vorgegeben." TextWrapping="Wrap"
                               Style="{StaticResource Typo.Small}" Foreground="{DynamicResource Brush.Muted}" />
                </Border>

                <Border Background="{DynamicResource Brush.Panel2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Control}" Margin="0,0,0,13" Padding="11"
                        Visibility="{Binding IsPendingMatch, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Getippte Partie: Die Teams sind durch die im Tippspiel angelegte Paarung vorgegeben." TextWrapping="Wrap"
                               Style="{StaticResource Typo.Small}" Foreground="{DynamicResource Brush.Muted}" />
                </Border>

                <Grid Margin="0,0,0,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Datum" FontFamily="{DynamicResource Font.Mono}" FontSize="10.5" CharacterSpacing="120"
                                   Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,6" />
                        <DatePicker SelectedDate="{Binding PlayedAtDate}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Uhrzeit (HH:mm)" FontFamily="{DynamicResource Font.Mono}" FontSize="10.5" CharacterSpacing="120"
                                   Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding PlayedAtTime, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <controls:EyebrowLabel Text="Team A" />
                <Grid Margin="0,0,0,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" ItemsSource="{Binding AvailablePlayers}" DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding TeamAPlayer1}" IsEnabled="{Binding ArePlayerSelectorsEnabled}" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding AvailablePlayers}" DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding TeamAPlayer2}" IsEnabled="{Binding ArePlayerSelectorsEnabled}" />
                </Grid>

                <controls:EyebrowLabel Text="Team B" />
                <Grid Margin="0,0,0,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" ItemsSource="{Binding AvailablePlayers}" DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding TeamBPlayer1}" IsEnabled="{Binding ArePlayerSelectorsEnabled}" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding AvailablePlayers}" DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding TeamBPlayer2}" IsEnabled="{Binding ArePlayerSelectorsEnabled}" />
                </Grid>

                <!-- Prognose (mockup .prognose), same treatment as
                     MatchEditView - two team labels instead of two player
                     labels. -->
                <Border Background="{DynamicResource Brush.Panel2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                        CornerRadius="9" Padding="11,13" Margin="0,0,0,13"
                        Visibility="{Binding HasPrediction, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding PredictionTeamALabel}" FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                                   Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding PredictionTeamBLabel}" FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                                   Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,8" />
                        <Border Height="8" CornerRadius="6" Background="{DynamicResource Brush.Rubber}" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding PredictionAFraction, Converter={StaticResource FractionToGridLengthConverter}}" />
                                    <ColumnDefinition Width="{Binding PredictionAFraction, Converter={StaticResource FractionToGridLengthConverter}, ConverterParameter=Invert}" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource Brush.Table}" CornerRadius="6,0,0,6" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Text="Gewinner (für Schnellauswahl)" FontFamily="{DynamicResource Font.Mono}" FontSize="10.5"
                           CharacterSpacing="120" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,13">
                    <RadioButton Content="Team A" GroupName="DoublesWinnerSide" Margin="0,0,16,0" VerticalAlignment="Center"
                                 IsChecked="{Binding WinnerSide, Converter={StaticResource StringEqualsConverter}, ConverterParameter=A}" />
                    <RadioButton Content="Team B" GroupName="DoublesWinnerSide" VerticalAlignment="Center"
                                 IsChecked="{Binding WinnerSide, Converter={StaticResource StringEqualsConverter}, ConverterParameter=B}" />
                </StackPanel>

                <TextBlock Text="Schnellauswahl Ergebnis (Sätze Gewinner:Verlierer)" FontFamily="{DynamicResource Font.Mono}"
                           FontSize="10.5" CharacterSpacing="120" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding QuickResults}" Margin="0,0,0,13">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding LabelForSideA}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                    Command="{Binding DataContext.ApplyQuickResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,0,0,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Sätze Team A" FontFamily="{DynamicResource Font.Mono}" FontSize="10.5" CharacterSpacing="120"
                                   Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding TeamASets, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Sätze Team B" FontFamily="{DynamicResource Font.Mono}" FontSize="10.5" CharacterSpacing="120"
                                   Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding TeamBSets, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Satzergebnisse (optional)" FontFamily="{DynamicResource Font.Mono}" FontSize="10.5" CharacterSpacing="120"
                           Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding SetEntries}" ItemTemplate="{StaticResource SetResultEntryTemplate}" Margin="0,0,0,4" />
                <Button Content="+ Satz hinzufügen" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                        Margin="0,0,0,13" Command="{Binding AddSetCommand}" />

                <TextBlock Text="Kommentar / Notiz" FontFamily="{DynamicResource Font.Mono}" FontSize="10.5" CharacterSpacing="120"
                           Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,6" />
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,13" />

                <TextBlock Text="{Binding FormErrorMessage}" Foreground="{DynamicResource Brush.Lose}"
                           TextWrapping="Wrap" Margin="0,0,0,13"
                           Visibility="{Binding FormErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Abbrechen" Style="{StaticResource SecondaryButton}" Margin="0,0,9,0"
                            Command="{Binding CancelFormCommand}" />
                    <Button Content="Speichern" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <controls:CardControl Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Team-Konstellationen (Ranking)" Style="{StaticResource SectionLabelText}" Margin="0,0,0,8" />
                <DataGrid ItemsSource="{Binding Rankings}" BorderThickness="0" Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Team" Binding="{Binding PairLabel}" Width="220" />
                        <DataGridTextColumn Header="Spiele" Binding="{Binding Played}" Width="70" />
                        <DataGridTextColumn Header="Siege" Binding="{Binding Wins}" Width="70" />
                        <DataGridTextColumn Header="Niederlagen" Binding="{Binding Losses}" Width="100" />
                        <DataGridTextColumn Header="Siegquote" Binding="{Binding WinRateLabel}" Width="90" />
                        <DataGridTextColumn Header="Hinweis" Binding="{Binding LowSampleLabel}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </controls:CardControl>

        <controls:CardControl>
            <StackPanel>
                <TextBlock Text="Doppel-Spielverlauf" Style="{StaticResource SectionLabelText}" Margin="0,0,0,8" />
                <DataGrid ItemsSource="{Binding Matches}" BorderThickness="0" Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Datum" Binding="{Binding PlayedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="140" />
                        <DataGridTextColumn Header="Team A" Binding="{Binding TeamALabel}" Width="180" />
                        <DataGridTextColumn Header="Team B" Binding="{Binding TeamBLabel}" Width="180" />
                        <DataGridTextColumn Header="Ergebnis" Binding="{Binding ResultLabel}" Width="80" />
                        <DataGridTextColumn Header="Sieger" Binding="{Binding WinnerLabel}" Width="180" />
                        <DataGridTemplateColumn Header="Aktionen" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Löschen" Style="{StaticResource CompactDangerButton}"
                                            Click="OnDeleteClick" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </controls:CardControl>
    </StackPanel>
</UserControl>
