<UserControl x:Class="PingPongStats.App.Views.PlayersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Spieler" Style="{StaticResource HeadingText}" />
            <CheckBox Grid.Column="1" Content="Archivierte anzeigen" VerticalAlignment="Center" Margin="0,0,16,0"
                      IsChecked="{Binding ShowInactive}" />
            <Button Grid.Column="2" Content="+ Neuer Spieler" Style="{StaticResource PrimaryButton}"
                    Command="{Binding NewPlayerCommand}" />
        </Grid>

        <StackPanel Margin="0,0,0,16" Width="280" HorizontalAlignment="Left">
            <TextBlock Text="Suche nach Anzeigename" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16"
                Visibility="{Binding IsEditFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{Binding EditFormTitle}" Style="{StaticResource SectionLabelText}" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Anzeigename *" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding EditDisplayName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="E-Mail" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Vorname" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding EditFirstName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Nachname" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding EditLastName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding EditErrorMessage}" Foreground="{DynamicResource Brush.Danger}"
                           Margin="0,4,0,8" TextWrapping="Wrap"
                           Visibility="{Binding EditErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Abbrechen" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding CancelEditCommand}" />
                    <Button Content="Speichern" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid ItemsSource="{Binding Players}" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Anzeigename" Binding="{Binding DisplayName}" Width="150" />
                    <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="150" />
                    <DataGridTextColumn Header="E-Mail" Binding="{Binding Email}" Width="180" />
                    <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding IsActive}" Width="60" />
                    <DataGridTextColumn Header="Spiele" Binding="{Binding Played}" Width="60" />
                    <DataGridTextColumn Header="Siege" Binding="{Binding Wins}" Width="60" />
                    <DataGridTextColumn Header="Niederlagen" Binding="{Binding Losses}" Width="90" />
                    <DataGridTextColumn Header="Siegquote" Binding="{Binding WinRateLabel}" Width="80" />
                    <DataGridTextColumn Header="Elo" Binding="{Binding EloLabel}" Width="70" />
                    <DataGridTemplateColumn Header="Aktionen" Width="280">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Bearbeiten" Style="{StaticResource SecondaryButton}" Margin="0,2,6,2"
                                            Click="OnEditClick" />
                                    <Button Content="Aktiv/Inaktiv" Style="{StaticResource SecondaryButton}" Margin="0,2,6,2"
                                            Click="OnToggleActiveClick" />
                                    <Button Content="Löschen" Style="{StaticResource DangerButton}" Margin="0,2,0,2"
                                            Click="OnDeleteClick" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </StackPanel>
</UserControl>
