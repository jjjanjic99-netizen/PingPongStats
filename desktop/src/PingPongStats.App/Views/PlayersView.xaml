<UserControl x:Class="PingPongStats.App.Views.PlayersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PingPongStats.App.Controls">
    <StackPanel>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Spieler" Style="{StaticResource HeadingText}" />
            <CheckBox Grid.Column="1" Content="Archivierte anzeigen" VerticalAlignment="Center" Margin="0,0,16,0"
                      IsChecked="{Binding ShowInactive}" />
            <Button Grid.Column="2" Content="+ Neuer Spieler" Style="{StaticResource PrimaryButton}"
                    Command="{Binding NewPlayerCommand}" />
        </Grid>

        <StackPanel Margin="0,0,0,16" Width="280" HorizontalAlignment="Left">
            <TextBlock Text="Suche nach Anzeigename" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16"
                Visibility="{Binding IsEditFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{Binding EditFormTitle}" Style="{StaticResource SectionLabelText}" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <controls:AvatarControl Player="{Binding EditPreviewPlayer}" DataPath="{Binding DataPath}"
                                                 OverrideImagePath="{Binding EditAvatarPendingSourcePath}" Size="L" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Center">
                            <Button Content="Bild auswählen" Style="{StaticResource CompactSecondaryButton}" Margin="0,0,6,0"
                                    Command="{Binding PickAvatarCommand}" />
                            <Button Content="Entfernen" Style="{StaticResource CompactDangerButton}"
                                    Command="{Binding RemoveAvatarCommand}" />
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Anzeigename *" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding EditDisplayName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2">
                            <TextBlock Text="E-Mail" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Vorname" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding EditFirstName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Nachname" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding EditLastName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PIN ist aktuell gesetzt." Style="{StaticResource StatLabelText}" Margin="0,0,0,4"
                                   Visibility="{Binding EditPlayerHasPin, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="Neuer PIN (4 Ziffern, optional)" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding EditPinInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" Width="100" HorizontalAlignment="Left" />
                        <TextBlock Text="Login ohne PIN möglich, solange keiner gesetzt ist. PIN leer lassen, um den bestehenden PIN zu behalten."
                                   Style="{StaticResource StatLabelText}" TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="320" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                        <CheckBox Content="Bestehenden PIN entfernen" IsChecked="{Binding EditRemovePin}"
                                  Visibility="{Binding EditPlayerHasPin, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding EditErrorMessage}" Foreground="{DynamicResource Brush.Danger}"
                           Margin="0,4,0,8" TextWrapping="Wrap"
                           Visibility="{Binding EditErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Abbrechen" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding CancelEditCommand}" />
                    <Button Content="Speichern" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid ItemsSource="{Binding Players}" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Bild" Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:AvatarControl Player="{Binding Player}"
                                                         DataPath="{Binding DataContext.DataPath, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         Size="S" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Anzeigename" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding BadgeNamesTooltip}">
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding BadgeIconsLabel}" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="13" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="150" />
                    <DataGridTextColumn Header="E-Mail" Binding="{Binding Email}" Width="180" />
                    <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding IsActive, Mode=OneWay}" Width="60" IsReadOnly="True" />
                    <DataGridTextColumn Header="Spiele" Binding="{Binding Played}" Width="60" />
                    <DataGridTextColumn Header="Siege" Binding="{Binding Wins}" Width="60" />
                    <DataGridTextColumn Header="Niederlagen" Binding="{Binding Losses}" Width="90" />
                    <DataGridTextColumn Header="Siegquote" Binding="{Binding WinRateLabel}" Width="80" />
                    <DataGridTextColumn Header="Elo" Binding="{Binding EloLabel}" Width="70" />
                    <DataGridTemplateColumn Header="Aktionen" Width="300">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Bearbeiten" Style="{StaticResource CompactSecondaryButton}" Margin="0,0,6,0"
                                            Click="OnEditClick" />
                                    <Button Content="Aktiv/Inaktiv" Style="{StaticResource CompactSecondaryButton}" Margin="0,0,6,0"
                                            Click="OnToggleActiveClick" />
                                    <Button Content="Löschen" Style="{StaticResource CompactDangerButton}"
                                            Click="OnDeleteClick" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </StackPanel>
</UserControl>
