<UserControl x:Class="PingPongStats.App.Views.HallOfFameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PingPongStats.App.Controls">
    <StackPanel>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Hall of Fame" Style="{StaticResource HeadingText}" />
            <Button Grid.Column="1" Content="Aktualisieren" Style="{StaticResource SecondaryButton}"
                    Command="{Binding RefreshCommand}" />
        </Grid>

        <TextBlock Text="Abgeschlossene Saisons" Style="{StaticResource SectionLabelText}" Margin="0,0,0,12" />
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16"
                Visibility="{Binding HasCompletedSeasons, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <TextBlock Text="Noch keine abgeschlossene Saison (Saison-Enddatum liegt noch nicht in der Vergangenheit)."
                       Style="{StaticResource StatLabelText}" TextWrapping="Wrap" />
        </Border>
        <ItemsControl ItemsSource="{Binding CompletedSeasons}" Margin="0,0,0,16"
                      Visibility="{Binding HasCompletedSeasons, Converter={StaticResource BoolToVisibilityConverter}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Grid.Column="1" Text="{Binding DateRangeLabel}" Style="{StaticResource StatLabelText}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{Binding TotalGames, StringFormat='{}{0} Spiele in dieser Saison'}"
                                       Style="{StaticResource StatLabelText}" Margin="0,0,0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <controls:AvatarControl Player="{Binding SinglesWinner}"
                                                             DataPath="{Binding DataContext.DataPath, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                             Size="M" />
                                    <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="SIEGER EINZEL" Style="{StaticResource StatLabelText}" />
                                        <TextBlock Text="{Binding SinglesWinner.DisplayName}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <controls:AvatarControl Player="{Binding DoublesWinner}"
                                                             DataPath="{Binding DataContext.DataPath, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                             Size="M" />
                                    <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="SIEGER DOPPEL" Style="{StaticResource StatLabelText}" />
                                        <TextBlock Text="{Binding DoublesWinner.DisplayName}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Podest (Einzel)" Style="{StaticResource StatLabelText}" Margin="0,12,0,4" />
                            <ItemsControl ItemsSource="{Binding SinglesPodium}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorder}" Width="140" Margin="0,0,8,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Rank, StringFormat='#{0}'}" Style="{StaticResource SectionLabelText}"
                                                           HorizontalAlignment="Center" Margin="0,0,0,8" />
                                                <controls:AvatarControl Player="{Binding Player}"
                                                                         DataPath="{Binding DataContext.DataPath, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                         Size="S" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding DisplayName}" HorizontalAlignment="Center" Margin="0,8,0,0"
                                                           TextWrapping="Wrap" TextAlignment="Center" />
                                                <TextBlock Text="{Binding Points, StringFormat='{}{0} Punkte'}" Style="{StaticResource StatLabelText}"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Abgeschlossene Turniere" Style="{StaticResource SectionLabelText}" Margin="0,0,0,12" />
        <Border Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,16">
            <StackPanel>
                <DataGrid ItemsSource="{Binding CompletedTournaments}" BorderThickness="0" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
                        <DataGridTextColumn Header="Modus" Binding="{Binding ModeLabel}" Width="90" />
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="110" />
                        <DataGridTextColumn Header="Sieger" Binding="{Binding WinnerLabel}" Width="200" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <TextBlock Text="Rekord-Tafel (all-time)" Style="{StaticResource SectionLabelText}" Margin="0,0,0,12" />
        <ItemsControl ItemsSource="{Binding RecordBoard}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,8,8">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource StatLabelText}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasRecord, Converter={StaticResource BoolToVisibilityConverter}}">
                                <controls:AvatarControl Player="{Binding Player}"
                                                         DataPath="{Binding DataContext.DataPath, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         Size="M" />
                                <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ValueLabel}" />
                                    <TextBlock Text="{Binding DateLabel}" Style="{StaticResource StatLabelText}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Noch kein Rekord vorhanden." Style="{StaticResource StatLabelText}"
                                       Visibility="{Binding HasRecord, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
