<UserControl x:Class="PingPongStats.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock Text="Einstellungen" Style="{StaticResource HeadingText}" Margin="0,0,0,16" />

        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Datenpfad" Style="{StaticResource SectionLabelText}" Margin="0,0,0,8" />
                <TextBlock Text="{Binding CurrentDataPath}" TextWrapping="Wrap" Margin="0,0,0,12"
                           Foreground="{DynamicResource Brush.TextPrimary}" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Datenpfad ändern…" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding ChangeDataPathCommand}" />
                    <Button Content="XML-Dateien neu laden" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding ReloadCommand}" />
                    <Button Content="Backup-Ordner öffnen" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding OpenBackupFolderCommand}" />
                    <Button Content="Datenordner öffnen" Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenDataFolderCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Darstellung" Style="{StaticResource SectionLabelText}" Margin="0,0,0,8" />

                <TextBlock Text="Ansichtsgrösse" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                <ComboBox Width="160" HorizontalAlignment="Left"
                          ItemsSource="{Binding UiScaleOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding SelectedUiScale}" Margin="0,0,0,12" />

                <CheckBox Content="Gewinn-Animation nach dem Speichern anzeigen" IsChecked="{Binding ShowWinAnimation}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Sound-Effekte" Style="{StaticResource SectionLabelText}" Margin="0,0,0,8" />
                <CheckBox Content="Sound-Effekte aktivieren (Sieg, Turniersieg, neues Badge)" IsChecked="{Binding SoundEnabled}" Margin="0,0,0,12" />

                <TextBlock Text="Lautstärke" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" Minimum="0" Maximum="1" TickFrequency="0.1"
                            Value="{Binding SoundVolume, Mode=TwoWay}" VerticalAlignment="Center"
                            IsEnabled="{Binding SoundEnabled}" />
                    <TextBlock Grid.Column="1" Text="{Binding SoundVolume, StringFormat={}{0:P0}}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Export (CSV, Excel-kompatibel, UTF-8)" Style="{StaticResource SectionLabelText}" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Spieler exportieren" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding ExportPlayersCommand}" />
                    <Button Content="Spiele exportieren" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding ExportMatchesCommand}" />
                    <Button Content="Statistiken exportieren" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ExportStatisticsCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Saisons" Style="{StaticResource SectionLabelText}" Margin="0,0,0,8" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Name" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewSeasonName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Start" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding NewSeasonStartDate}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Ende" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding NewSeasonEndDate}" />
                    </StackPanel>
                </Grid>

                <CheckBox Content="Sofort aktivieren" IsChecked="{Binding NewSeasonIsActive}" Margin="0,0,0,8" />

                <TextBlock Text="{Binding SeasonErrorMessage}" Foreground="{DynamicResource Brush.Danger}"
                           Margin="0,0,0,8" TextWrapping="Wrap"
                           Visibility="{Binding SeasonErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />

                <Button Content="Saison anlegen" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                        Margin="0,0,0,12" Command="{Binding CreateSeasonCommand}" />

                <ItemsControl ItemsSource="{Binding Seasons}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DateRangeLabel}" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Style="{StaticResource StatLabelText}" />
                                    <TextBlock Text="Aktiv" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold"
                                               Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Aktivieren/Deaktivieren" Style="{StaticResource CompactSecondaryButton}"
                                        Command="{Binding DataContext.ToggleSeasonActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}"
                Visibility="{Binding IsSeedDataAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Entwickleroption (nur Debug-Build)" Style="{StaticResource SectionLabelText}" Margin="0,0,0,8" />
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource Brush.TextSecondary}"
                           Text="Erzeugt 8 Beispielspieler und 65 Beispielspiele. Achtung: Ersetzt alle bestehenden Daten am aktuellen Datenpfad." />
                <Button Content="Testdaten erzeugen" Style="{StaticResource DangerButton}" HorizontalAlignment="Left"
                        Click="OnSeedDataClick" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
