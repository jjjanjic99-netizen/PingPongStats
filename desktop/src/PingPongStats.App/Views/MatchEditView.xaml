<UserControl x:Class="PingPongStats.App.Views.MatchEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardBorder}" MaxWidth="640" HorizontalAlignment="Left">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource HeadingText}" Margin="0,0,0,16" />

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="10"
                    Visibility="{Binding IsTournamentMatch, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Turnier-Partie: Die Spieler sind durch die Turnierpaarung vorgegeben." TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="10"
                    Visibility="{Binding IsPendingMatch, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Getippte Partie: Die Spieler sind durch die im Tippspiel angelegte Paarung vorgegeben." TextWrapping="Wrap" />
            </Border>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Datum" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                    <DatePicker SelectedDate="{Binding PlayedAtDate}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Uhrzeit (HH:mm)" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding PlayedAtTime, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Spieler A" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding AvailablePlayers}" DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding PlayerA}" IsEnabled="{Binding ArePlayerSelectorsEnabled}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Spieler B" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding AvailablePlayers}" DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding PlayerB}" IsEnabled="{Binding ArePlayerSelectorsEnabled}" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="10"
                    Visibility="{Binding HasPrediction, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Prognose:" Style="{StaticResource StatLabelText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding PredictionPlayerALabel}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding PredictionPlayerBLabel}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <TextBlock Text="Gewinner (für Schnellauswahl)" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton Content="Spieler A" GroupName="WinnerSide" Margin="0,0,16,0" VerticalAlignment="Center"
                             IsChecked="{Binding WinnerSide, Converter={StaticResource StringEqualsConverter}, ConverterParameter=A}" />
                <RadioButton Content="Spieler B" GroupName="WinnerSide" VerticalAlignment="Center"
                             IsChecked="{Binding WinnerSide, Converter={StaticResource StringEqualsConverter}, ConverterParameter=B}" />
            </StackPanel>

            <TextBlock Text="Schnellauswahl Ergebnis (Sätze Gewinner:Verlierer)" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
            <ItemsControl ItemsSource="{Binding QuickResults}" Margin="0,0,0,12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding LabelForSideA}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                Command="{Binding DataContext.ApplyQuickResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Sätze Spieler A" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding PlayerASets, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Sätze Spieler B" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding PlayerBSets, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Satzergebnisse (optional)" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
            <ItemsControl ItemsSource="{Binding SetEntries}" ItemTemplate="{StaticResource SetResultEntryTemplate}" Margin="0,0,0,4" />
            <Button Content="+ Satz hinzufügen" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                    Margin="0,0,0,12" Command="{Binding AddSetCommand}" />

            <TextBlock Text="Kommentar / Notiz" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}"
                       TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Command="{Binding CancelCommand}" />
                <Button Content="Speichern" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
