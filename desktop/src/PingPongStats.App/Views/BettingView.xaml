<UserControl x:Class="PingPongStats.App.Views.BettingView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PingPongStats.App.Controls">
    <StackPanel>
        <controls:CardControl Margin="0,0,0,14">
            <TextBlock TextWrapping="Wrap" Style="{StaticResource Typo.Small}" Foreground="{DynamicResource Brush.Muted}"
                       Text="Reine Punkte-Wette zum Spass - es geht um kein echtes Geld und kein Guthaben. Richtiger Tipp = 1 Punkt, war der getippte Sieger laut Elo-Prognose ein Underdog (unter 40% Siegwahrscheinlichkeit), gibt es 3 Punkte." />
        </controls:CardControl>

        <controls:CardControl Margin="0,0,0,14"
                               Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <TextBlock Text="Bitte zuerst anmelden, um Tipps abzugeben. Partien anlegen und die Rangliste ansehen geht auch ohne Anmeldung."
                       TextWrapping="Wrap" Style="{StaticResource Typo.Small}" Foreground="{DynamicResource Brush.Muted}" />
        </controls:CardControl>

        <!-- Offene Partien (mockup's ".card"/eyebrow "Offene Partie · dein
             Tipp"). PendingMatchRow only exposes a combined "X vs. Y" Label,
             no per-side Player references, so this shows the label as a
             single line rather than the mockup's two-avatar "vs" layout - see
             ABWEICHUNGEN.md. -->
        <controls:CardControl Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Style="{StaticResource Typo.Eyebrow}" Text="OFFENE PARTIEN" />
                <TextBlock Text="Aktuell keine offenen Partien." Style="{StaticResource Typo.Small}"
                           Foreground="{DynamicResource Brush.Muted}"
                           Visibility="{Binding HasOpenPendingMatches, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                <ItemsControl ItemsSource="{Binding OpenPendingMatches}"
                              Visibility="{Binding HasOpenPendingMatches, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Brush.Panel2}" BorderBrush="{DynamicResource Brush.Line}"
                                    BorderThickness="1" CornerRadius="{DynamicResource Radius.Card}" Margin="0,0,0,12" Padding="13,11">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontFamily="{DynamicResource Font.Display}"
                                                   FontWeight="Bold" FontSize="17" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <controls:Pill Grid.Column="1" Text="{Binding SourceLabel}" VerticalAlignment="Center" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding PickOptions}" Margin="0,10,0,0"
                                                  Visibility="{Binding CanPlaceBet, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,0,9,0"
                                                        Command="{Binding ElementName=Root, Path=DataContext.PlaceBetCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Panel2}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                                                            <Setter Property="BorderThickness" Value="1" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Chalk}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrentPick}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.Ball}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.OnBall}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ball}" />
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock Text="{Binding Label, StringFormat='{}{0}'}" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Du bist an dieser Partie beteiligt - kein Tipp möglich."
                                               Style="{StaticResource Typo.Small}" Foreground="{DynamicResource Brush.Muted}"
                                               Margin="0,10,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding CanPlaceBet, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                                    <Button Content="Ergebnis erfassen" Style="{StaticResource SecondaryButton}"
                                            Margin="0,10,0,0" HorizontalAlignment="Left"
                                            Command="{Binding ElementName=Root, Path=DataContext.RecordResultCommand}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsTournamentLinked, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </controls:CardControl>

        <!-- Tipp-Rangliste (mockup .row list with a 🔮 Hellseher pill for the
             top scorer and a hit-rate pill otherwise). -->
        <controls:CardControl Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Style="{StaticResource Typo.Eyebrow}" Text="TIPP-RANGLISTE" />
                <ItemsControl ItemsSource="{Binding Leaderboard}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:RowItem Pos="{Binding Rank}" AvatarPlayer="{Binding Player}"
                                               AvatarDataPath="{Binding ElementName=Root, Path=DataContext.DataPath}"
                                               NameText="{Binding DisplayName}" ValueText="{Binding TotalPoints}">
                                <controls:RowItem.TrailingContent>
                                    <controls:Pill Text="{Binding HitRateLabel}" />
                                </controls:RowItem.TrailingContent>
                            </controls:RowItem>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Nur Punkte, kein Geld. Auf eigene Spiele kann nicht getippt werden." Style="{StaticResource Typo.Small}"
                           Foreground="{DynamicResource Brush.Muted}" Margin="0,10,0,0" />
            </StackPanel>
        </controls:CardControl>

        <!-- Neue Partie anlegen: no mockup equivalent (the mockup only shows
             already-open pairings) - restyled with the same building
             blocks, structure unchanged. -->
        <controls:CardControl>
            <StackPanel>
                <TextBlock Style="{StaticResource Typo.Eyebrow}" Text="NEUE PARTIE ZUM TIPPEN ANLEGEN" />
                <CheckBox Content="Doppel" IsChecked="{Binding IsDoublesMode}" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,12" Visibility="{Binding IsDoublesMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Spieler A" Style="{StaticResource Typo.Small}" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding AvailablePlayers}" DisplayMemberPath="DisplayName" SelectedItem="{Binding NewPlayerA}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Spieler B" Style="{StaticResource Typo.Small}" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding AvailablePlayers}" DisplayMemberPath="DisplayName" SelectedItem="{Binding NewPlayerB}" />
                    </StackPanel>
                </Grid>

                <StackPanel Visibility="{Binding IsDoublesMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Team A" Style="{StaticResource Typo.Small}" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding AvailablePlayers}" DisplayMemberPath="DisplayName" SelectedItem="{Binding NewTeamAPlayer1}" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding AvailablePlayers}" DisplayMemberPath="DisplayName" SelectedItem="{Binding NewTeamAPlayer2}" />
                    </Grid>
                    <TextBlock Text="Team B" Style="{StaticResource Typo.Small}" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding AvailablePlayers}" DisplayMemberPath="DisplayName" SelectedItem="{Binding NewTeamBPlayer1}" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding AvailablePlayers}" DisplayMemberPath="DisplayName" SelectedItem="{Binding NewTeamBPlayer2}" />
                    </Grid>
                </StackPanel>

                <TextBlock Text="{Binding SetupErrorMessage}" Foreground="{DynamicResource Brush.Lose}"
                           TextWrapping="Wrap" Margin="0,0,0,12"
                           Visibility="{Binding SetupErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />

                <Button Content="Partie anlegen" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                        Command="{Binding CreatePendingMatchCommand}" />
            </StackPanel>
        </controls:CardControl>
    </StackPanel>
</UserControl>
