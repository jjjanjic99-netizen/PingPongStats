<UserControl x:Class="PingPongStats.App.Views.BettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PingPongStats.App.Controls">
    <StackPanel>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Tippspiel" Style="{StaticResource HeadingText}" />
            <Button Grid.Column="1" Content="Aktualisieren" Style="{StaticResource SecondaryButton}"
                    Command="{Binding RefreshCommand}" />
        </Grid>

        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <TextBlock TextWrapping="Wrap"
                       Text="Reine Punkte-Wette zum Spass - es geht um kein echtes Geld und kein Guthaben. Richtiger Tipp = 1 Punkt, war der getippte Sieger laut Elo-Prognose ein Underdog (unter 40% Siegwahrscheinlichkeit), gibt es 3 Punkte." />
        </Border>

        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16"
                Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <TextBlock Text="Bitte zuerst anmelden, um Tipps abzugeben. Partien anlegen und die Rangliste ansehen geht auch ohne Anmeldung."
                       TextWrapping="Wrap" Style="{StaticResource StatLabelText}" />
        </Border>

        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Neue Partie zum Tippen anlegen" Style="{StaticResource SectionLabelText}" Margin="0,0,0,12" />
                <CheckBox Content="Doppel" IsChecked="{Binding IsDoublesMode}" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,12" Visibility="{Binding IsDoublesMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Spieler A" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding AvailablePlayers}" DisplayMemberPath="DisplayName" SelectedItem="{Binding NewPlayerA}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Spieler B" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding AvailablePlayers}" DisplayMemberPath="DisplayName" SelectedItem="{Binding NewPlayerB}" />
                    </StackPanel>
                </Grid>

                <StackPanel Visibility="{Binding IsDoublesMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Team A" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding AvailablePlayers}" DisplayMemberPath="DisplayName" SelectedItem="{Binding NewTeamAPlayer1}" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding AvailablePlayers}" DisplayMemberPath="DisplayName" SelectedItem="{Binding NewTeamAPlayer2}" />
                    </Grid>
                    <TextBlock Text="Team B" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding AvailablePlayers}" DisplayMemberPath="DisplayName" SelectedItem="{Binding NewTeamBPlayer1}" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding AvailablePlayers}" DisplayMemberPath="DisplayName" SelectedItem="{Binding NewTeamBPlayer2}" />
                    </Grid>
                </StackPanel>

                <TextBlock Text="{Binding SetupErrorMessage}" Foreground="{DynamicResource Brush.Danger}"
                           TextWrapping="Wrap" Margin="0,0,0,12"
                           Visibility="{Binding SetupErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />

                <Button Content="Partie anlegen" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                        Command="{Binding CreatePendingMatchCommand}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Offene Partien" Style="{StaticResource SectionLabelText}" Margin="0,0,0,12" />
                <ItemsControl ItemsSource="{Binding OpenPendingMatches}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{Binding SourceLabel}" Style="{StaticResource StatLabelText}" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding PickOptions}" Margin="0,8,0,0"
                                                  Visibility="{Binding CanPlaceBet, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,0,8,8"
                                                        Command="{Binding DataContext.PlaceBetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrentPick}" Value="True">
                                                                    <Setter Property="Style" Value="{StaticResource PrimaryButton}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock Text="{Binding Label, StringFormat='Tipp: {0}'}" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Du bist an dieser Partie beteiligt - kein Tipp möglich."
                                               Style="{StaticResource StatLabelText}" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding CanPlaceBet, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                                    <Button Content="Ergebnis erfassen" Style="{StaticResource SecondaryButton}"
                                            Margin="0,8,0,0" HorizontalAlignment="Left"
                                            Command="{Binding DataContext.RecordResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsTournamentLinked, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Aktuell keine offenen Partien." Style="{StaticResource StatLabelText}"
                           Visibility="{Binding HasOpenPendingMatches, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}" Padding="0">
            <StackPanel>
                <TextBlock Text="Tipp-Rangliste" Style="{StaticResource SectionLabelText}" Margin="16,16,16,8" />
                <DataGrid ItemsSource="{Binding Leaderboard}" BorderThickness="0" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="40" />
                        <DataGridTemplateColumn Header="Bild" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:AvatarControl Player="{Binding Player}"
                                                             DataPath="{Binding DataContext.DataPath, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                             Size="S" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Spieler" Binding="{Binding DisplayName}" Width="160" />
                        <DataGridTextColumn Header="Punkte" Binding="{Binding TotalPoints}" Width="80" />
                        <DataGridTextColumn Header="Tipps" Binding="{Binding BetsPlaced}" Width="70" />
                        <DataGridTextColumn Header="Richtig" Binding="{Binding CorrectPicks}" Width="70" />
                        <DataGridTextColumn Header="Trefferquote" Binding="{Binding HitRateLabel}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
