<UserControl x:Class="PingPongStats.App.Views.MatchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Spiele" Style="{StaticResource HeadingText}" Margin="0,0,0,16" />

        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Spieler" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding FilterablePlayers}" DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding FilterPlayer}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Gewinner" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding FilterablePlayers}" DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding FilterWinner}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Von" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding FilterFrom}" />
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Bis" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding FilterTo}" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <CheckBox Content="Absteigend sortieren" IsChecked="{Binding SortDescending}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button Content="Filtern" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyFilterCommand}" Margin="0,0,8,0" />
                    <Button Content="Zurücksetzen" Style="{StaticResource SecondaryButton}" Command="{Binding ClearFilterCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid ItemsSource="{Binding Matches}" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Datum" Binding="{Binding PlayedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="140" />
                    <DataGridTextColumn Header="Spieler A" Binding="{Binding PlayerAName}" Width="130" />
                    <DataGridTextColumn Header="Spieler B" Binding="{Binding PlayerBName}" Width="130" />
                    <DataGridTextColumn Header="Ergebnis" Binding="{Binding ResultLabel}" Width="80" />
                    <DataGridTextColumn Header="Gewinner" Binding="{Binding WinnerName}" Width="130" />
                    <DataGridTextColumn Header="Notiz" Binding="{Binding Notes}" Width="200" />
                    <DataGridTemplateColumn Header="Aktionen" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Bearbeiten" Style="{StaticResource SecondaryButton}" Margin="0,2,6,2"
                                            Click="OnEditClick" />
                                    <Button Content="Löschen" Style="{StaticResource DangerButton}" Margin="0,2,0,2"
                                            Click="OnDeleteClick" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </StackPanel>
</UserControl>
