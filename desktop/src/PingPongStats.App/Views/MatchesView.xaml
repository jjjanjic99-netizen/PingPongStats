<UserControl x:Class="PingPongStats.App.Views.MatchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Spiele" Style="{StaticResource HeadingText}" Margin="0,0,0,16" />

        <!-- Dashboard S/N drill-down filter chip (R3): shown while a player +
             result-type filter set from the Elo-Rangliste is active; removing
             it clears the whole filter form via the existing ClearFilterCommand. -->
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="10,8" HorizontalAlignment="Left"
                Visibility="{Binding HasResultFilterChip, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ResultFilterChipLabel}" VerticalAlignment="Center" FontWeight="SemiBold" />
                <Button Content="✕" Style="{StaticResource CompactSecondaryButton}" Margin="10,0,0,0"
                        Command="{Binding ClearFilterCommand}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Spieler" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding FilterablePlayers}" DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding FilterPlayer}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Gewinner" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding FilterablePlayers}" DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding FilterWinner}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Von" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding FilterFrom}" />
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Bis" Style="{StaticResource StatLabelText}" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding FilterTo}" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <CheckBox Content="Absteigend sortieren" IsChecked="{Binding SortDescending}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button Content="Filtern" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyFilterCommand}" Margin="0,0,8,0" />
                    <Button Content="Zurücksetzen" Style="{StaticResource SecondaryButton}" Command="{Binding ClearFilterCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid ItemsSource="{Binding Matches}" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Datum" Binding="{Binding PlayedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="140" />
                    <DataGridTextColumn Header="Spieler A" Binding="{Binding PlayerAName}" Width="130" />
                    <DataGridTextColumn Header="Spieler B" Binding="{Binding PlayerBName}" Width="130" />
                    <DataGridTextColumn Header="Ergebnis" Binding="{Binding ResultLabel}" Width="80" />
                    <DataGridTextColumn Header="Gewinner" Binding="{Binding WinnerName}" Width="130" />
                    <DataGridTextColumn Header="Notiz" Binding="{Binding Notes}" Width="200" />
                    <DataGridTemplateColumn Header="Aktionen" Width="190">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Bearbeiten" Style="{StaticResource CompactSecondaryButton}" Margin="0,0,6,0"
                                            Click="OnEditClick" />
                                    <Button Content="Löschen" Style="{StaticResource CompactDangerButton}"
                                            Click="OnDeleteClick" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </StackPanel>
</UserControl>
