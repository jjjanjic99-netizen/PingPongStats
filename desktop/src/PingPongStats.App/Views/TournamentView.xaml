<UserControl x:Class="PingPongStats.App.Views.TournamentView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PingPongStats.App.Controls">
    <StackPanel>
        <!-- Setup: only shown while no tournament is currently running. No
             direct mockup equivalent (the mockup only shows a tournament
             already in progress) - restyled with the same building blocks,
             structure unchanged. -->
        <controls:CardControl Margin="0,0,0,14"
                               Visibility="{Binding HasActiveTournament, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <StackPanel>
                <controls:EyebrowLabel Text="Neues Turnier starten" />

                <TextBlock Text="Turnier-Name" Style="{StaticResource Typo.Small}" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,4" />
                <TextBox Text="{Binding NewTournamentName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                <CheckBox Content="Doppel-Turnier" IsChecked="{Binding IsDoublesMode}" Margin="0,0,0,12" />

                <TextBlock Text="Teilnehmer auswählen" Style="{StaticResource Typo.Small}" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding AvailableParticipants}" Margin="0,0,0,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Brush.Panel2}" BorderBrush="{DynamicResource Brush.Line}"
                                    BorderThickness="1" CornerRadius="{DynamicResource Radius.Control}" Margin="0,0,8,8" Padding="8">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <controls:AvatarControl Player="{Binding Player}"
                                                             DataPath="{Binding ElementName=Root, Path=DataContext.DataPath}"
                                                             Size="S" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Player.DisplayName}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,12"
                            Visibility="{Binding IsDoublesMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button Content="Teams generieren" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding GenerateTeamsCommand}" />
                    <Button Content="Teams auslosen" Style="{StaticResource SecondaryButton}"
                            Command="{Binding DrawRandomTeamsCommand}" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Teams}" Margin="0,0,0,12"
                              Visibility="{Binding IsDoublesMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding ElementName=Root, Path=DataContext.AvailableParticipants}"
                                          DisplayMemberPath="Player.DisplayName" SelectedValuePath="Player"
                                          SelectedValue="{Binding Player1}" />
                                <ComboBox Grid.Column="2"
                                          ItemsSource="{Binding ElementName=Root, Path=DataContext.AvailableParticipants}"
                                          DisplayMemberPath="Player.DisplayName" SelectedValuePath="Player"
                                          SelectedValue="{Binding Player2}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding SetupErrorMessage}" Foreground="{DynamicResource Brush.Lose}"
                           TextWrapping="Wrap" Margin="0,0,0,12"
                           Visibility="{Binding SetupErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />

                <Button Content="Turnier starten" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                        Command="{Binding StartTournamentCommand}" />
            </StackPanel>
        </controls:CardControl>

        <!-- Header + bracket (mockup .bracket/.br-col/.match/.side). -->
        <controls:CardControl Margin="0,0,0,14"
                               Visibility="{Binding ViewingTournamentLabel, Converter={StaticResource StringToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <StackPanel>
                    <controls:EyebrowLabel Text="Laufendes Turnier" Margin="0,0,0,5" />
                    <TextBlock Text="{Binding ViewingTournamentLabel}" FontFamily="{DynamicResource Font.Display}"
                               FontWeight="ExtraBold" FontSize="26" />
                </StackPanel>
                <Button Content="Turnier abbrechen" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="24,0,0,0"
                        Visibility="{Binding HasActiveTournament, Converter={StaticResource BoolToVisibilityConverter}}"
                        Click="OnAbortClick" />
            </StackPanel>
        </controls:CardControl>

        <controls:CardControl Margin="0,0,0,14"
                               Visibility="{Binding ViewingTournamentLabel, Converter={StaticResource StringToVisibilityConverter}}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding BracketRounds}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,20,0" MinWidth="186">
                                <controls:EyebrowLabel Text="{Binding RoundLabel}" Margin="0,0,0,2" />
                                <ItemsControl ItemsSource="{Binding Slots}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="9" BorderThickness="1" Margin="0,0,0,12" ClipToBounds="True">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlayable}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ball}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <Grid Margin="10,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <controls:AvatarControl Grid.Column="0" Size="S" VerticalAlignment="Center"
                                                                                 DataPath="{Binding ElementName=Root, Path=DataContext.DataPath}"
                                                                                 Player="{Binding EntrantA.Players, Converter={StaticResource FirstPlayerConverter}}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding EntrantA.Label}" FontSize="13"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding EntrantA.IsTbd}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                                                                            <Setter Property="FontStyle" Value="Italic" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                    <Border Height="1" Background="#991E5265" />
                                                    <Grid Margin="10,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <controls:AvatarControl Grid.Column="0" Size="S" VerticalAlignment="Center"
                                                                                 DataPath="{Binding ElementName=Root, Path=DataContext.DataPath}"
                                                                                 Player="{Binding EntrantB.Players, Converter={StaticResource FirstPlayerConverter}}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding EntrantB.Label}" FontSize="13"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding EntrantB.IsTbd}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                                                                            <Setter Property="FontStyle" Value="Italic" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                    <TextBlock Text="{Binding WinnerLabel, StringFormat='Sieger: {0}'}"
                                                               Style="{StaticResource Typo.Small}" Foreground="{DynamicResource Brush.Win}"
                                                               Margin="10,0,10,8"
                                                               Visibility="{Binding IsDecided, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <Button Content="Spielen" Style="{StaticResource PrimaryButton}"
                                                            Margin="10,0,10,8" HorizontalAlignment="Stretch"
                                                            Command="{Binding ElementName=Root, Path=DataContext.PlaySlotCommand}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding IsPlayable, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <Button Content="Tippen" Style="{StaticResource SecondaryButton}"
                                                            Margin="10,0,10,10" HorizontalAlignment="Stretch"
                                                            Command="{Binding ElementName=Root, Path=DataContext.RequestBetCommand}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding IsPlayable, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </controls:CardControl>

        <controls:CardControl>
            <StackPanel>
                <TextBlock Text="Abgeschlossene / abgebrochene Turniere" Style="{StaticResource SectionLabelText}" Margin="0,0,0,8" />
                <DataGrid ItemsSource="{Binding CompletedTournaments}" BorderThickness="0" Background="Transparent" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
                        <DataGridTextColumn Header="Modus" Binding="{Binding ModeLabel}" Width="90" />
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="110" />
                        <DataGridTextColumn Header="Sieger" Binding="{Binding WinnerLabel}" Width="200" />
                        <DataGridTemplateColumn Header="Aktionen" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Anzeigen" Style="{StaticResource CompactSecondaryButton}"
                                            Command="{Binding ElementName=Root, Path=DataContext.ViewTournamentCommand}"
                                            CommandParameter="{Binding Tournament}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </controls:CardControl>
    </StackPanel>
</UserControl>
