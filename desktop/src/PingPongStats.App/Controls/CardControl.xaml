<UserControl x:Class="PingPongStats.App.Controls.CardControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Mockup .card: Panel fill, 1px Line border, 12px radius, plus the
         signature "table line" (.card::after) - a 2px gradient line flush
         with the card's bottom edge, transparent → rgba(238,244,243,.16) →
         transparent. A plain Border/Decorator can't host this second visual,
         which is why this exists as its own templated UserControl (see
         desktop/design/ABWEICHUNGEN.md for where CardBorder - the plain Style
         - is still used instead). -->
    <Border Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Line}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.Card}"
            ClipToBounds="True">
        <Grid>
            <ContentPresenter Margin="{DynamicResource Spacing.CardPadding}"
                              Content="{Binding ElementName=Root, Path=Content}"
                              ContentTemplate="{Binding ElementName=Root, Path=ContentTemplate}" />
            <Border VerticalAlignment="Bottom" Height="2" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0" />
                        <GradientStop Color="#29EEF4F3" Offset="0.12" />
                        <GradientStop Color="#29EEF4F3" Offset="0.88" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>
    </Border>
</UserControl>
