<UserControl x:Class="PingPongStats.App.Controls.RowItem"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PingPongStats.App.Controls">
    <!-- Mockup .row: optional rank, small avatar, flex-1 name, optional
         trailing pill/badge content, mono value on the right, thin bottom
         divider. Covers the common case (Elo-Rangliste, Bilanz-Countdown,
         Hall-of-Fame lists); rows with several numeric columns (the Liga
         table) are still hand-built directly - see
         desktop/design/ABWEICHUNGEN.md. -->
    <Grid>
        <Grid Margin="0,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="11" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="11" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="11" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="11" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="PosBlock" Grid.Column="0" FontFamily="{DynamicResource Font.Mono}" FontSize="12"
                       Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
            <!-- No x:Name here: AvatarControl is a UserControl, and this
                 name was unused in code-behind anyway - removed as the same
                 category of namescope risk that broke StatTile/EyebrowLabel
                 (MC3093), even though the compiler hadn't reached this file
                 yet. See ABWEICHUNGEN.md. -->
            <controls:AvatarControl Grid.Column="2" Size="S" VerticalAlignment="Center"
                                     Player="{Binding ElementName=Root, Path=AvatarPlayer}"
                                     DataPath="{Binding ElementName=Root, Path=AvatarDataPath}" />
            <TextBlock x:Name="NameBlock" Grid.Column="4" FontWeight="Medium" FontSize="14"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <ContentPresenter Grid.Column="6" VerticalAlignment="Center"
                              Content="{Binding ElementName=Root, Path=TrailingContent}" />
            <TextBlock x:Name="ValueBlock" Grid.Column="8" FontFamily="{DynamicResource Font.Mono}" FontSize="13"
                       Foreground="{DynamicResource Brush.Chalk}" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>

        <Border x:Name="Divider" Height="1" VerticalAlignment="Bottom" Background="#801E5265" />
    </Grid>
</UserControl>
