<UserControl x:Class="PingPongStats.App.Controls.BarRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Mockup .bar-row: mono label (62px), a rounded track with a
         Table→Ball gradient fill, mono value on the right. The fill's width
         is a star-sized column ratio (FillColumn/RemainderColumn, set in
         code-behind from NormalizedValue) rather than a measured pixel width -
         avoids a value converter and reflows correctly with the row's
         actual width. -->
    <Grid Margin="0,0,0,9">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="62" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="36" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="LabelBlock" Grid.Column="0" FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                   Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />

        <Border Grid.Column="2" Background="{DynamicResource Brush.Panel2}" CornerRadius="6" Height="9"
                VerticalAlignment="Center" ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FillColumn" Width="0*" />
                    <ColumnDefinition x:Name="RemainderColumn" Width="1*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="6">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{StaticResource Color.Table}" Offset="0" />
                            <GradientStop Color="{StaticResource Color.Ball}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
        </Border>

        <TextBlock x:Name="ValueBlock" Grid.Column="4" FontFamily="{DynamicResource Font.Mono}" FontSize="11.5"
                   Foreground="{DynamicResource Brush.Chalk}" VerticalAlignment="Center" TextAlignment="Right" />
    </Grid>
</UserControl>
